{
  "schema": "ridal-derived",
  "schema_version": "1",
  "items": [
    {
      "id": "thickness",
      "name": "Ice thickness (0.49 order statistic)",
      "expression": "if count(bed) + count(bed_no_temperate) >= count(bed_not_visible) { percentile_lower(concatenate(bed, bed_no_temperate), 49.0) } else { NaN }",
      "unit": "meters",
      "color": "#000000",
      "show": true
    },
    {
      "id": "cts_depth",
      "name": "CTS depth (0.49 order statistic)",
      "expression": "percentile_lower(concatenate(bed_no_temperate, temperate_ice), 49.0)",
      "unit": "meters",
      "color": "#e6194b"
    },
    {
      "id": "cts_filled",
      "name": "CTS depth, gaps filled with the bed",
      "expression": "if is_nan(cts_depth) { thickness } else { cts_depth }",
      "unit": "meters"
    },
    {
      "id": "temperate_raw",
      "name": "Temperate ice above the bed (before the study rules)",
      "expression": "clamp(thickness - cts_filled, 0.0, thickness)",
      "unit": "meters"
    },
    {
      "id": "temperate",
      "name": "Temperate ice above the bed",
      "expression": "if count(temperate_ice) == 0 || count(temperate_ice) / max(count(concatenate(bed_no_temperate, temperate_ice)), 1.0) < 0.25 { 0.0 } else if temperate_raw / thickness > 0.5 && temperate_raw <= 17.0 { thickness } else { temperate_raw }",
      "unit": "meters",
      "color": "#e6194b",
      "show": true
    },
    {
      "id": "thickness_user_count",
      "name": "Contributors with a bed pick",
      "expression": "count(concatenate(bed, bed_no_temperate))",
      "unit": "dimensionless"
    },
    {
      "id": "thickness_user_lower",
      "name": "Thickness, lower quartile",
      "expression": "percentile_lower(concatenate(bed, bed_no_temperate), 25.0)",
      "unit": "meters"
    },
    {
      "id": "thickness_user_upper",
      "name": "Thickness, upper quartile",
      "expression": "percentile_lower(concatenate(bed, bed_no_temperate), 75.0)",
      "unit": "meters"
    },
    {
      "id": "thickness_user_std",
      "name": "Thickness, standard deviation",
      "expression": "std(concatenate(bed, bed_no_temperate))",
      "unit": "meters"
    },
    {
      "id": "thickness_user_nmad",
      "name": "Thickness, normalised median absolute deviation",
      "expression": "nmad(concatenate(bed, bed_no_temperate))",
      "unit": "meters"
    }
  ]
}
