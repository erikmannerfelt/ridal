{% extends "base.html.jinja" %}
{% block title %}Settings - Ridal{% endblock %}
{% block content %}
  <h1>Settings</h1>

  {% if not project %}
    <div class="warning">
      <p>
        This catalog is not a Ridal project, so there is nothing to
        configure. Run <code>ridal project init</code> in the directory
        being served and restart.
      </p>
    </div>
  {% else %}
    <dl class="card-meta settings-summary">
      {% if project_name %}<dt>Project</dt><dd>{{ project_name }}</dd>{% endif %}
      <dt>Location</dt><dd class="path">{{ project_root }}</dd>
      <dt>You</dt>
      <dd>
        {% if current_user %}
          {{ current_user }} <span class="hint">({{ current_role }})</span>
        {% else %}
          not signed in <span class="hint">(viewer)</span>
        {% endif %}
      </dd>
    </dl>
  {% endif %}

  <div id="settings-error" class="warning" role="status" aria-live="polite" hidden></div>

  {% if project %}
    {#- Section one: preferences. Everyone who has an account gets these,
        because choosing how you like to look at something is the floor of
        what having an account means rather than a permission. -#}
    <section class="settings-section">
      <h2>My settings</h2>
      {% if signed_in %}
        <p class="hint">
          Yours alone. They override the project defaults below for you, and
          for nobody else. An address with <code>?profile=</code> or
          <code>?xscale=</code> in it still wins for that one page.
        </p>
        <form id="my-settings-form" class="settings-form" novalidate>
          <label class="settings-field">
            <span class="settings-label">Render profile</span>
            <select id="my-profile">
              <option value="">Loading&hellip;</option>
            </select>
            <span class="hint">
              &ldquo;Project default&rdquo; leaves it unset, so a change to
              the project default reaches you.
            </span>
          </label>
          <label class="settings-field">
            <span class="settings-label">Horizontal scale</span>
            <select id="my-xscale">
              <option value="">Loading&hellip;</option>
            </select>
          </label>
          {#- #141. "Follow this device" is the absence of a choice rather
              than a third theme, which is what lets a laptop that switches
              at dusk keep switching. -#}
          <label class="settings-field">
            <span class="settings-label">Theme</span>
            <select id="my-theme">
              <option value="">Loading&hellip;</option>
            </select>
            <span class="hint">
              &ldquo;Follow this device&rdquo; uses whatever your system asks
              for, including when it changes during the day.
            </span>
          </label>
          {#- #143. A starting state, not a lock: the viewer has its own
              toggle, and picking brings the lines back by itself. -#}
          <label class="settings-field checkbox">
            <input type="checkbox" id="my-show-picks">
            Show interpretations when a radargram opens
            <span class="hint">
              Off means the viewer opens on the radargram alone. The
              viewer&rsquo;s own &ldquo;Show picks&rdquo; button changes it
              for that page either way, and starting to pick always shows
              them.
            </span>
          </label>
          {#- #166. The two download dialogs open on these. -#}
          <label class="settings-field">
            <span class="settings-label">Layer point spacing</span>
            <select id="my-spacing">
              <option value="">Loading&hellip;</option>
            </select>
            <span class="hint">
              What the layer-point downloads open on. Still changeable in the
              dialog for a download that needs something else.
            </span>
          </label>
          <label class="settings-field">
            <span class="settings-label">Layer point format</span>
            <select id="my-format">
              <option value="">Loading&hellip;</option>
            </select>
            <span class="hint">
              GeoJSON in WGS84 is the portable choice and what RFC 7946
              requires; the native variant writes the radargram&rsquo;s own
              projected coordinates instead.
          <label class="settings-field">
            <span class="settings-label">Basemap</span>
            <select id="my-basemap">
              <option value="">Loading&hellip;</option>
            </select>
            <span class="hint">
              What the maps in the catalog and the viewer draw on. Each map
              also has a layer control for switching without coming here,
              which lasts until the page is reloaded.
            </span>
          </label>
          <button type="submit">Save my settings</button>
          <span id="my-settings-status" class="pick-status"></span>
        </form>
      {% else %}
        {#- Shown rather than hidden, following the same rule as the picking
            toolbar: a missing control reads as a missing feature. -#}
        <p class="hint">
          Personal settings need an account &mdash; there is nowhere to keep
          them otherwise.
          {% if authentication_configured %}
            <a href="/login">Sign in</a> to choose your own; until then the
            project defaults apply.
          {% else %}
            This project has no accounts, so the project defaults apply to
            everyone.
          {% endif %}
        </p>
      {% endif %}
    </section>

    {#- Section two: the project defaults, which are what someone who has
        not chosen sees. Thin until the processing settings arrive, which is
        the honest outcome of moving the render settings into preferences
        rather than a reason to have resisted it. -#}
    <section class="settings-section">
      <h2>Project</h2>
      {% if not can_edit_project %}
        <div class="warning">
          {% if read_only_server %}
            <p>
              This server is read-only, so the project defaults are shown
              but cannot be changed. Whoever runs it can restart without
              <code>--read-only</code>.
            </p>
          {% else %}
            <p>
              Changing the project defaults needs the <code>operator</code>
              role. They are shown here so you can see what applies.
            </p>
          {% endif %}
        </div>
      {% endif %}
      <form id="settings-form" class="settings-form" novalidate>
        <label class="settings-field">
          <span class="settings-label">Default render profile</span>
          <select id="default-profile" {% if not can_edit_project %}disabled{% endif %}>
            <option value="">Loading&hellip;</option>
          </select>
          <span class="hint">
            What someone who has not chosen a profile sees. Setting this
            never overwrites a person who has chosen.
          </span>
        </label>
        <label class="settings-field">
          <span class="settings-label">Default horizontal scale</span>
          <select id="default-xscale" {% if not can_edit_project %}disabled{% endif %}>
            <option value="">Loading&hellip;</option>
          </select>
          <span class="hint">
            How far radargrams are stretched horizontally when opened.
            Survey speed decides how much ground a trace covers, so a
            project whose lines are short or densely sampled often wants
            more than 1&times;.
          </span>
        </label>
        {#- #166 at the project layer: a survey that always exports the same
            way should say so once. Everyone who has not chosen for
            themselves gets these. -#}
        <label class="settings-field">
          <span class="settings-label">Default layer point spacing</span>
          <select id="default-spacing" {% if not can_edit_project %}disabled{% endif %}>
            <option value="">Loading&hellip;</option>
          </select>
          <span class="hint">
            Exporting at one spacing across a survey is what makes two
            people&rsquo;s files comparable.
          </span>
        </label>
        <label class="settings-field">
          <span class="settings-label">Default layer point format</span>
          <select id="default-format" {% if not can_edit_project %}disabled{% endif %}>
            <option value="">Loading&hellip;</option>
          </select>
        </label>
        {% if can_edit_project %}
          <button type="submit">Save project defaults</button>
          <span id="settings-status" class="pick-status"></span>
        {% endif %}
      </form>

      {#- Said plainly rather than left to be discovered: this section writes
          to a file people are invited to edit by hand. -#}
      <p class="hint">
        The project defaults are stored in <code>ridal.toml</code> at the
        location above. Saving rewrites only the value being changed, so
        comments and anything you have edited by hand are kept.
      </p>
    </section>

    {#- Section two and a half: the basemaps every map draws on (#177). Its
        own section rather than two more fields in the one above, because it
        is a list rather than a value, and because the thing it configures is
        visible on other pages rather than here. -#}
    <section class="settings-section" id="basemaps-section">
      <h2>Basemaps</h2>
      <p class="hint">
        What the maps in the catalog and the viewer draw on. Ridal has one
        built in; add any XYZ tile service here and every map grows a control
        for switching between them. Which one a person sees by default is
        their own setting, falling back to the project default below.
      </p>

      {#- Said where the button is rather than left to be discovered: this is
          the one part of the settings page that does not preserve
          hand-written comments. -#}
      {% if can_edit_project %}
        <p class="hint">
          Saving rewrites the whole <code>[[basemaps]]</code> block in
          <code>ridal.toml</code>, so comments inside <em>it</em> are not
          kept. The rest of the file is left alone.
        </p>
      {% endif %}

      {#- What the file defines but Ridal cannot draw. Hidden until there is
          something to say. -#}
      <div id="basemap-problems" class="warning" role="status" hidden></div>

      <div id="basemaps-list"></div>

      {% if can_edit_project %}
        <form id="add-basemap" class="add-layer" novalidate>
          <h3>Add a basemap</h3>
          <p class="hint">
            The address is the tile template the provider documents, with
            <code>{z}</code>, <code>{x}</code> and <code>{y}</code> left in
            it. Anything Ridal cannot fill in &mdash; an API key, say &mdash;
            has to be substituted before pasting it here.
          </p>
          {#- The name comes first because the id is derived from it: the id
              box's placeholder shows what will be stored if it is left
              alone, which is the answer almost everyone wants. -#}
          <div class="add-layer-fields">
            <label>Name
              <input type="text" name="name" required placeholder="OpenStreetMap">
            </label>
            <label>Address
              <input type="text" name="url" required size="42"
                     placeholder="https://tile.openstreetmap.org/{z}/{x}/{y}.png"
                     autocomplete="off" autocapitalize="none" spellcheck="false">
            </label>
            <label>Id <span class="hint">(from the name)</span>
              <input type="text" name="id" pattern="[a-z0-9_\-]+"
                     placeholder="osm" autocomplete="off"
                     autocapitalize="none" spellcheck="false">
            </label>
          </div>
          <button type="submit">Add</button>
          <span class="hint">
            Attribution and the tile details can be filled in once it is
            listed.
          </span>
        </form>

        <form id="basemap-form" class="settings-form" novalidate>
          <label class="settings-field">
            <span class="settings-label">Default basemap</span>
            <select id="default-basemap"></select>
            <span class="hint">
              What someone who has not chosen sees. Setting it never
              overwrites a person who has chosen.
            </span>
          </label>
          <label class="settings-field checkbox">
            <input type="checkbox" id="built-in-basemap">
            Offer ESRI World Imagery
            <span class="hint">
              Switched off with no other basemap defined, it comes back
              anyway rather than leaving the maps blank.
            </span>
          </label>
          <button type="submit">Save basemaps</button>
          <span id="basemap-status" class="pick-status"></span>
        </form>

      {% endif %}
    </section>

    {#- Section two and three quarters: vector overlays (#177). Its own
        section rather than more rows in the basemap table, because a
        basemap is what a map is drawn *on* and an overlay is something
        drawn *over* it -- and because they are switched on differently:
        one basemap at a time, any number of overlays, all of them off
        until asked for. -#}
    <section class="settings-section" id="overlays-section">
      <h2>Overlays</h2>
      <p class="hint">
        Shapes drawn over every map: outlines, sample sites, an earlier
        season&rsquo;s tracks. Each becomes an entry in the layer control on
        the catalog and the viewer, off until switched on, and is fetched
        only once somebody does.
      </p>

      <div id="overlay-problems" class="warning" role="status" hidden></div>

      <div id="overlays-list"></div>

      {% if can_edit_project %}
        <form id="add-overlay" class="add-layer" novalidate>
          <h3>Add an overlay</h3>
          <p class="hint">
            The address of a GeoJSON file in WGS84. It is fetched by each
            reader&rsquo;s own browser, so it has to be reachable from
            theirs &mdash; a file on a site that does not allow
            cross-origin reads cannot be drawn, and will say so on the map.
          </p>
          <div class="add-layer-fields">
            <label>Layer name
              <input type="text" name="name" required
                     placeholder="Catchment outlines">
            </label>
            <label>Address
              <input type="text" name="url" required size="42"
                     placeholder="https://example.org/shapes/catchments.geojson"
                     autocomplete="off" autocapitalize="none" spellcheck="false">
            </label>
            <label>Id <span class="hint">(from the name)</span>
              <input type="text" name="id" pattern="[a-z0-9_\-]+"
                     placeholder="catchments" autocomplete="off"
                     autocapitalize="none" spellcheck="false">
            </label>
          </div>
          <button type="submit">Add</button>
          <span class="hint">
            The popup fields can be filled in once it is listed.
          </span>
        </form>

        <form id="overlay-form" class="settings-form" novalidate>
          <p class="hint">
            Saving rewrites the whole <code>[[overlays]]</code> block in
            <code>ridal.toml</code>, so comments inside <em>it</em> are not
            kept. The rest of the file is left alone.
          </p>
          <button type="submit">Save overlays</button>
          <span id="overlay-status" class="pick-status"></span>
        </form>
      {% endif %}
    </section>

    {#- Section three: who may do what. A distinct area rather than a few
        more fields, because everything in it is about people rather than
        about the project's data, and it is the only part where a mistake
        locks someone out. -#}
    {% if can_edit_access %}
      <section class="settings-section" id="access-section">
        <h2>Access</h2>

        <h3>People</h3>
        {#- Said before the table rather than discovered after it. The
            role and download controls are selects that apply on change,
            and there is a Save button further down this page for a
            different thing entirely -- without this line the obvious
            reading is that the button saves the table. -#}
        <p class="hint">
          Role and download changes take effect as you make them; there is
          nothing to save here. A change reaches whoever it is about on
          their next request, including one already signed in.
        </p>

        <table id="users-table" class="layers-table">
          <thead>
            <tr>
              <th scope="col">Name</th>
              <th scope="col">Role</th>
              <th scope="col">Downloads</th>
              <th scope="col">Status</th>
              <th scope="col"><span class="visually-hidden">Actions</span></th>
            </tr>
          </thead>
          <tbody></tbody>
        </table>

        {#- The one moment an invite token exists: only its hash is stored,
            so this is shown once and cannot be shown again. -#}
        <div id="invite-result" class="warning" hidden>
          <p>
            <strong>Invite link for <span id="invite-who"></span>.</strong>
            Send it however you already talk to that person. It works once
            and expires in <span id="invite-days"></span> days, and it is as
            sensitive as a password until then.
          </p>
          <p><code id="invite-link" class="path"></code></p>
          <p class="hint">
            This is the only time it is shown. If it is lost, issue another.
          </p>
        </div>

        <form id="add-user" class="add-layer" novalidate>
          <h3>Add someone</h3>
          <p class="hint">
            You create the account; they set their own password through a
            one-time link, so no password is ever known to two people.
          </p>
          <div class="add-layer-fields">
            <label>Name
              <input type="text" name="name" required pattern="[a-z0-9_\-]+"
                     placeholder="erik" autocomplete="off"
                     autocapitalize="none" spellcheck="false">
            </label>
            <label>Role
              <select name="role"></select>
            </label>
            <label>Downloads
              <select name="download"></select>
            </label>
          </div>
          <button type="submit">Create account and get a link</button>
        </form>

        {#- Bulk-specific warnings sit beside the control they are about,
            rather than at the top of the page where they read as unrelated
            to "Add several people". -#}
        <div id="bulk-warning" class="warning" role="status" aria-live="polite" hidden></div>

        <details class="bulk-users" id="bulk-users">
          <summary>Add several people</summary>
          <p class="hint">
            Invite mode creates separate one-time links, so each person sets
            their own password. Use password mode only for a small workshop:
            the generated passwords must be printed or handed out by you.
          </p>
          <form id="bulk-user-form" class="add-layer" novalidate>
            <div class="add-layer-fields">
              <label class="checkbox bulk-random">
                <input type="checkbox" id="bulk-random-names">
                Use random usernames instead of the prefix
              </label>
              <label>Prefix
                <input type="text" name="prefix" value="student" required
                       pattern="[a-z0-9_\-]+" autocomplete="off"
                       autocapitalize="none" spellcheck="false">
              </label>
              <label>Count
                <input type="number" name="count" value="10" min="1" max="100" required>
              </label>
              <label>Role
                <select name="role"></select>
              </label>
              <label>Downloads
                <select name="download"></select>
              </label>
            </div>
            <div class="bulk-actions">
              <button type="submit">Create invite links</button>
              <button type="button" id="bulk-passwords" class="danger">
                Create with generated passwords
              </button>
            </div>
            <label class="settings-field checkbox bulk-risk">
              <input type="checkbox" id="bulk-risk">
              I understand that generated passwords are shared secrets and are
              less safe than invite links.
            </label>
          </form>
          <div id="bulk-result" class="bulk-result" hidden></div>
        </details>

        {#- The heading lives *inside* the container rather than above it,
            so the grey block and its Save button are visibly one thing
            that belongs to this heading. Outside, the container read as
            orphaned and its button as though it might save the table
            above. -#}
        <form id="access-form" class="settings-form" novalidate>
          <h3>People who are not signed in</h3>
          <p class="hint">
            This is the only part of Access with a Save button: it is one
            setting for the whole project, rather than a change to
            somebody in particular.
          </p>
          <label class="settings-field checkbox">
            <input type="checkbox" id="require-auth">
            Require a login to read the catalog
            <span class="hint">
              Off by default: public read, authenticated write. Turning this
              on hides the catalog, the viewer and the API from anyone who
              is not signed in.
            </span>
          </label>
          <label class="settings-field">
            <span class="settings-label">Anonymous downloads</span>
            <select id="anonymous-download"></select>
            <span class="hint">
              What someone who is not signed in may download, when reading
              is public.
            </span>
          </label>
          <button type="submit">Save</button>
          <span id="access-status" class="pick-status"></span>
        </form>

        {#- Belongs beside the control, not only in the issue: otherwise
            someone builds a data-sharing policy on top of this believing it
            is airtight. -#}
        <div class="warning">
          <p>
            <strong>This controls downloading, not seeing.</strong> Anyone
            who can open a radargram is already looking at the image, and
            at the track on the map. Someone determined could save those a
            piece at a time whatever is set here, and stopping that would
            stop the viewer working for everybody.
          </p>
          <p>
            So use this to keep bulk downloads deliberate, and to say what
            the project expects of people. If somebody should not have the
            data at all, do not give them access to the project.
          </p>
        </div>
      </section>
    {% endif %}
  {% endif %}
{% endblock %}
{% block extrascript %}
  <script src="/static/settings.js"></script>
{% endblock %}
