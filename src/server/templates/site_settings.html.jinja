{% extends "base.html.jinja" %}
{% block title %}Settings - {{ site_name }}{% endblock %}
{% block content %}
  <h1>Settings</h1>

  <dl class="card-meta settings-summary">
    <dt>Site</dt><dd>{{ site_name }}</dd>
    <dt>You</dt>
    <dd>
      {{ current_user }} <span class="hint">({{ current_role }})</span>
    </dd>
  </dl>

  <div id="site-error" class="warning" role="status" aria-live="polite" hidden></div>

  {#- Personal settings that belong to the whole site rather than to one
      project (#214). The theme is the first of them: choosing a dark screen
      is about the reader, not the survey, so one choice follows them into
      every project they can open. -#}
  <section class="settings-section" id="my-site-settings-section">
    <h2>My site settings</h2>
    <p class="hint">
      Yours alone, and the same on every project of this site. A project has
      its own settings on its own settings page.
    </p>
    <form id="my-site-settings-form" class="settings-form" novalidate>
      <label class="settings-field">
        <span class="settings-label">Theme</span>
        <select id="site-theme">
          <option value="" {% if not active_theme %}selected{% endif %}>Follow this device</option>
          <option value="light" {% if active_theme == "light" %}selected{% endif %}>Light</option>
          <option value="dark" {% if active_theme == "dark" %}selected{% endif %}>Dark</option>
        </select>
        <span class="hint">
          &ldquo;Follow this device&rdquo; uses whatever your system asks
          for, including when it changes during the day.
        </span>
      </label>
      <button type="submit">Save site settings</button>
      <span id="site-settings-status" class="pick-status"></span>
    </form>
  </section>

  {#- API tokens (#341): what lets a script act as this account, in the
      projects it is granted and never above the membership there. Made and
      revoked only from a signed-in session, which the routes enforce. -#}
  <section class="settings-section" id="tokens-section">
    <h2>API tokens<a class="docs-help" href="{{ docs_base|safe }}deploy/accounts.html#api-tokens"
          target="_blank" rel="noopener" title="API tokens">?</a></h2>
    <p class="hint">
      A token lets a script, such as one using the Python client, act as you
      in the projects you grant it. In each, it has at most the role and
      download scope you give it, and never more than your own membership.
    </p>

    <div class="table-scroll">
    <table id="tokens-table" class="layers-table">
      <thead>
        <tr>
          <th scope="col">Name</th>
          <th scope="col">Projects</th>
          <th scope="col">Created</th>
          <th scope="col">Expires</th>
          <th scope="col"><span class="visually-hidden">Actions</span></th>
        </tr>
      </thead>
      <tbody></tbody>
    </table>
    </div>

    {#- The one moment a token's secret exists: only its hash is stored, so
        it is shown once, from the response that created it, and is never
        part of a page the server renders. -#}
    <div id="token-result" class="warning" hidden>
      <p><strong>Your new token <span id="token-result-name"></span>.</strong></p>
      <p><code id="token-secret" class="path token-secret"></code></p>
      <p>
        Copy it now: it will not be shown again. Keep it as you would a
        password. If it is lost, revoke it and create another.
      </p>
      <div class="bulk-actions">
        <button type="button" id="token-copy">Copy</button>
        <button type="button" id="token-done">Done</button>
        <span id="token-copy-status" class="pick-status"></span>
      </div>
    </div>

    {#- Projects a grant may name: the ones this account is a member of,
        with the membership's role and scope as the highest a grant can ask
        for there. A server administrator is a member everywhere. -#}
    {% set grantable = projects | selectattr("member") | list %}
    {% if grantable %}
      <form id="add-token" class="add-layer" novalidate>
        <h3>Create a token</h3>
        <div class="add-layer-fields">
          <label>Name
            <input type="text" name="name" required maxlength="64"
                   placeholder="laptop" autocomplete="off"
                   autocapitalize="none" spellcheck="false">
          </label>
          <label>Expires
            <select name="expires">
              <option value="30d">in 30 days</option>
              <option value="90d" selected>in 90 days</option>
              <option value="1y">in a year</option>
              <option value="never">never</option>
              <option value="custom">after&hellip;</option>
            </select>
          </label>
          <label id="token-custom-expiry" hidden>After
            <input type="text" name="custom_expires" placeholder="12w"
                   autocomplete="off" autocapitalize="none" spellcheck="false">
          </label>
        </div>
        <p class="hint">
          A custom lifetime is a number of days, weeks or years, such as
          <code>30d</code>, <code>12w</code> or <code>2y</code>.
        </p>

        <fieldset class="token-grants">
          <legend>Projects</legend>
          <div id="token-grant-rows"></div>
          <button type="button" id="token-add-grant">Add another project</button>
        </fieldset>
        {#- Cloned once per grant row. The options carry the membership as
            data, so the role and download lists can be cut down to it. -#}
        <template id="token-grant-template">
          <div class="add-layer-fields token-grant">
            <label>Project
              <select name="project">
                {% for project in grantable %}
                  <option value="{{ project.key }}" data-role="{{ project.role }}" data-download="{{ project.download }}">
                    {{- project.name }}{% if project.archived %} (archived){% endif -%}
                  </option>
                {% endfor %}
              </select>
            </label>
            <label>Role
              <select name="role">
                {% for role in roles %}
                  <option value="{{ role }}">{{ role }}</option>
                {% endfor %}
              </select>
            </label>
            <label>Downloads
              <select name="download">
                {% for scope in download_scopes %}
                  <option value="{{ scope }}">{{ scope }}</option>
                {% endfor %}
              </select>
            </label>
            <button type="button" class="danger token-remove-grant">Remove</button>
          </div>
        </template>

        <button type="submit">Create token</button>
      </form>
    {% else %}
      <p class="hint" id="token-no-projects">
        You are not a member of any project yet, so there is nowhere a token
        could act. Ask a project administrator to add you to one.
      </p>
    {% endif %}

    <div id="token-error" class="warning" role="status" aria-live="polite" hidden></div>
  </section>

  {% if server_admin %}
    {#- Accounts are server-wide (#214): they sign in once and are given a
        role in each project. Creating one is an identity act, so it lives
        here rather than on any project's settings page. -#}
    <section class="settings-section" id="accounts-section">
      <h2>Accounts<a class="docs-help" href="{{ docs_base|safe }}deploy/accounts.html"
            target="_blank" rel="noopener" title="Accounts and permissions">?</a></h2>
      <p class="hint">
        Everyone signs in with one of these, then sees the projects they are
        a member of. An account that is not a server administrator still
        needs a role in a project before it can open it.
      </p>

      <div class="table-scroll">
      <table id="accounts-table" class="layers-table">
        <thead>
          <tr>
            <th scope="col">Name</th>
            <th scope="col">Server admin</th>
            <th scope="col">Status</th>
            <th scope="col"><span class="visually-hidden">Actions</span></th>
          </tr>
        </thead>
        <tbody></tbody>
      </table>
      </div>

      {#- A read-only overview of who belongs where. Loaded when opened, so
          the accounts table stays quick for anyone who does not look. -#}
      <details id="memberships" class="bulk-users">
        <summary>Memberships</summary>
        <p class="hint">
          Every account and the projects it belongs to. Editable from each
          project's own settings page.
        </p>
        <div id="memberships-overview"></div>
      </details>

      {#- Every account's API tokens, so one can be revoked without
          reaching the server's command line. Loaded when opened. -#}
      <details id="all-tokens" class="bulk-users">
        <summary>Everyone's API tokens</summary>
        <p class="hint">
          Every token on this site. Revoking one stops it at once, for
          whichever script holds it.
        </p>
        <div class="table-scroll">
        <table id="all-tokens-table" class="layers-table">
          <thead>
            <tr>
              <th scope="col">Account</th>
              <th scope="col">Name</th>
              <th scope="col">Projects</th>
              <th scope="col">Created</th>
              <th scope="col">Expires</th>
              <th scope="col"><span class="visually-hidden">Actions</span></th>
            </tr>
          </thead>
          <tbody></tbody>
        </table>
        </div>
      </details>

      {#- The one moment an invite token exists: only its hash is stored,
          so this is shown once and cannot be shown again. -#}
      <div id="invite-result" class="warning" hidden>
        <p>
          <strong>Invite link for <span id="invite-who"></span>.</strong>
          Send it however you already talk to that person. It works once
          and expires in <span id="invite-days"></span> days, and it is as
          sensitive as a password until then.
        </p>
        <p><code id="invite-link" class="path"></code></p>
        <p class="hint">
          This is the only time it is shown. If it is lost, issue another.
        </p>
      </div>

      <form id="add-account" class="add-layer" novalidate>
        <h3>Add an account</h3>
        <p class="hint">
          You create the account; they set their own password through a
          one-time link, so no password is ever known to two people. The
          project and role below are granted when the link is used, so an
          account can arrive already belonging somewhere.
        </p>
        <div class="add-layer-fields">
          <label>Name
            <input type="text" name="name" required pattern="[a-z0-9_\-]+"
                   placeholder="erik" autocomplete="off"
                   autocapitalize="none" spellcheck="false">
          </label>
          <label>Project
            <select name="project">
              <option value="">No project</option>
              {% for project in projects %}
                <option value="{{ project.key }}">{{ project.name }}</option>
              {% endfor %}
            </select>
          </label>
          <label>Role
            <select name="role">
              {% for role in roles %}
                <option value="{{ role }}" {% if role == "picker" %}selected{% endif %}>{{ role }}</option>
              {% endfor %}
            </select>
          </label>
          <label>Downloads
            <select name="download">
              {% for scope in download_scopes %}
                <option value="{{ scope }}" {% if scope == "all" %}selected{% endif %}>{{ scope }}</option>
              {% endfor %}
            </select>
          </label>
        </div>
        <p class="hint">
          Server administrator rights are granted after the account has a
          password, from the list above &mdash; never to an invite, whose
          link would then carry the whole site with it.
        </p>
        <button type="submit">Create account and get a link</button>
      </form>

      {#- Refusals land here, beside the form that caused them. -#}
      <div id="account-error" class="warning" role="status" aria-live="polite" hidden></div>

      {#- Bulk-specific warnings sit beside the control they are about,
          rather than at the top of the page where they read as unrelated
          to "Add several people". -#}
      <div id="bulk-warning" class="warning" role="status" aria-live="polite" hidden></div>

      <details class="bulk-users" id="bulk-users">
        <summary>Add several people</summary>
        <p class="hint">
          Invite mode creates separate one-time links, so each person sets
          their own password. Use password mode only for a small workshop:
          the generated passwords must be printed or handed out by you.
        </p>
        <form id="bulk-account-form" class="add-layer" novalidate>
          <div class="add-layer-fields">
            <label class="checkbox bulk-random">
              <input type="checkbox" id="bulk-random-names">
              Use random usernames instead of the prefix
            </label>
            <label>Prefix
              <input type="text" name="prefix" value="student" required
                     pattern="[a-z0-9_\-]+" autocomplete="off"
                     autocapitalize="none" spellcheck="false">
            </label>
            <label>Count
              <input type="number" name="count" value="10" min="1" max="100" required>
            </label>
            <label>Project
              <select name="project">
                <option value="">No project</option>
                {% for project in projects %}
                  <option value="{{ project.key }}">{{ project.name }}</option>
                {% endfor %}
              </select>
            </label>
            <label>Role
              <select name="role">
                {% for role in roles %}
                  <option value="{{ role }}" {% if role == "picker" %}selected{% endif %}>{{ role }}</option>
                {% endfor %}
              </select>
            </label>
            <label>Downloads
              <select name="download">
                {% for scope in download_scopes %}
                  <option value="{{ scope }}" {% if scope == "all" %}selected{% endif %}>{{ scope }}</option>
                {% endfor %}
              </select>
            </label>
          </div>
          <div class="bulk-actions">
            <button type="submit">Create invite links</button>
            <button type="button" id="bulk-passwords" class="danger">
              Create with generated passwords
            </button>
          </div>
          <label class="settings-field checkbox bulk-risk">
            <input type="checkbox" id="bulk-risk">
            I understand that generated passwords are shared secrets and are
            less safe than invite links.
          </label>
        </form>
        <div id="bulk-result" class="bulk-result" hidden></div>
      </details>
    </section>

    {#- The site's ledger: who created, removed or changed accounts,
        memberships and projects. Read-only, and honest about what it is:
        anyone who can edit the site directory can edit this file too. -#}
    <section class="settings-section" id="history-section">
      <h2>History</h2>
      <p class="hint">
        What has happened to accounts, memberships and projects, most recent
        first. It is a record to work out what happened, not a security
        control: it can be edited by anyone with access to the site
        directory.
      </p>
      <details id="history" class="bulk-users">
        <summary>Show the history</summary>
        <div id="history-table"></div>
      </details>
    </section>

    {#- Making or unmaking a server administrator is the one account change
        that reaches every project, so it is confirmed rather than applied on
        a checkbox click. -#}
    <dialog id="admin-confirm-dialog">
      <h2 id="admin-confirm-title">Change server administration</h2>
      <p id="admin-confirm-message"></p>
      <div id="admin-confirm-error" class="warning" hidden></div>
      <p>
        <button type="button" id="admin-confirm-ok">Confirm</button>
        <button type="button" id="admin-confirm-cancel">Cancel</button>
      </p>
    </dialog>
  {% endif %}
{% endblock %}
{% block extrascript %}
  <script src="/static/site.js"></script>
{% endblock %}
