{% extends "base.html.jinja" %}
{% block title %}Radargram catalog - Ridal{% endblock %}
{% block content %}
  {#- One card definition, used by both the grouped and ungrouped sections,
      so the two cannot drift apart. `profile` is a macro argument, not a
      closed-over template variable -- minijinja macros do not reliably
      see the enclosing template's context. `page_base` and `api_base` are
      passed for the same reason. -#}
  {% macro entry_card(e, profile, page_base, api_base) %}
  <li class="card" id="card-{{ e.radargram_id }}">
    <a class="card-link" href="{{ page_base|safe }}/view/{{ e.radargram_id }}?profile={{ profile }}">
      <span class="card-thumb">
        {#- loading="lazy" is load-bearing, not decoration: #121 names it as
            the mechanism by which "the browser and server render-worker
            limit naturally bound initial work". Without it a 100-entry
            catalog would ask the server to render 100 overviews at once. -#}
        <img src="{{ api_base|safe }}/datasets/{{ e.radargram_id }}/views/standard/overview?profile={{ profile }}"
             alt="" loading="lazy" decoding="async" fetchpriority="low">
      </span>
    </a>
    {#- The name and what can be done to it on one line, under the picture.
        Two anchors to the same place rather than one wrapping both, because
        the menu is a button and a button inside a link is neither reliably
        clickable nor announced correctly. -#}
    <div class="card-heading">
      <a class="card-title" href="{{ page_base|safe }}/view/{{ e.radargram_id }}?profile={{ profile }}">
        {{- e.effective_label -}}
      </a>
      {#- One menu per card, because what it acts on is this radargram: a
          page-level menu would have to ask which. `site-menu` is the whole
          behaviour -- app.js closes every one of them on an outside click
          or Escape -- so replace and remove (#147) are new <li>s here and
          nothing else. -#}
      {% if can_edit_project %}
      <details class="site-menu card-menu">
        <summary>Edit</summary>
        <ul>
          <li>
            <button type="button"
                    data-edit-properties="{{ e.radargram_id }}"
                    data-edit-label="{{ e.effective_label }}">Edit properties</button>
          </li>
          {#- Only for a radargram the project owns. Replacing one in an
              external root would mean writing outside the project, which
              Ridal never does -- so the item is absent rather than
              present and refusing. -#}
          {% if e.in_project %}
          <li>
            <button type="button"
                    data-replace-radargram="{{ e.radargram_id }}"
                    data-replace-label="{{ e.effective_label }}">Replace with a new version&hellip;</button>
          </li>
          {#- Processing on the server (#382). Applying a draft replaces the
              file, so like Replace it is only for one the project owns.
              process.js says "Attach raw data…" instead when the project
              has none for it, once the menu is opened. -#}
          <li>
            <button type="button"
                    data-process-radargram="{{ e.radargram_id }}">Process&hellip;</button>
          </li>
          {% endif %}
          {#- Two different words for two different things. A radargram in
              the project is a file Ridal can delete; one in an external
              root is not, and calling both "Remove" would promise
              something about the archive that is not true. -#}
          <li>
            <button type="button" class="danger"
                    data-remove-radargram="{{ e.radargram_id }}"
                    data-remove-label="{{ e.effective_label }}"
                    data-remove-in-project="{% if e.in_project %}1{% else %}0{% endif %}">
              {%- if e.in_project %}Remove&hellip;{% else %}Stop serving&hellip;{% endif -%}
            </button>
          </li>
        </ul>
      </details>
      {% endif %}
    </div>
    {#- Only ever rendered for someone who can change it: the listing filter
        drops unlisted entries for everyone else, so this badge cannot leak
        the fact that a radargram exists. -#}
    {% if e.unlisted %}<p class="card-badge">Unlisted</p>{% endif %}
    {#- Interpretation progress takes the front row and the shape moves
        behind the toggle: the shape is the same on every card of a survey
        and answers no question anyone is asking of a catalog, while "has
        this been worked on?" is the reason to scan one.

        Only when the catalog is a project. "No picks yet" and "there is
        nowhere to save picks" are different states, and a card that says
        nothing at all is the honest rendering of the second. -#}
    <dl class="card-meta">
      <dt>ID</dt><dd><code>{{ e.radargram_id }}</code></dd>
      {% if e.line_count is not none %}
      <dt>Picked</dt>
      <dd>
        {%- if e.line_count == 0 -%}
          <span class="meta-none">None yet</span>
        {%- else -%}
          {{ e.contributor_count }} contributor{% if e.contributor_count != 1 %}s{% endif %}
          ({{ e.line_count }} line{% if e.line_count != 1 %}s{% endif %})
        {%- endif -%}
      </dd>
      {% endif %}
    </dl>
    {#- Shape, path and processed-datetime are secondary lookup info, not
        scanning info -- tucked behind a details toggle so the card grid
        stays scannable. -#}
    <details class="meta-details card-more">
      <summary>More info</summary>
      <dl class="card-meta">
        <dt>Size</dt><dd>{{ e.shape[1] }} traces &times; {{ e.shape[0] }} samples</dd>
        {% if e.track_length_m is not none %}
        {#- Metres below a kilometre, so the number agrees with the cursor
            readout in the viewer; kilometres above, where metres would be a
            five-digit figure. -#}
        <dt>Track length</dt>
        <dd>
          {%- if e.track_length_m >= 1000 -%}
            {{ "%.2f"|format(e.track_length_m / 1000) }} km
          {%- else -%}
            {{ "%.1f"|format(e.track_length_m) }} m
          {%- endif -%}
        </dd>
        {% endif %}
        <dt>Path</dt><dd class="path">{{ e.relative_path }}</dd>
        <dt>Processed</dt><dd>{{ e.processing_datetime_display }}</dd>
      </dl>
    </details>
  </li>
  {% endmacro %}

  {#- One menu definition for every scope on the page: the catalog-wide one
      and one per group. `base` is the API prefix the items hang off, so a
      new merged product is a line here and works at every scope at once.
      `project` is passed in for the same reason as `profile` above. -#}
  {#- Each entry is gated on the caller's download scope, and the menu
      disappears when nothing is left in it: a control that answers with an
      error is a worse way to learn about a permission than never having
      been offered one.

      "Layer points" additionally needs a signed-in user. A merged download
      covers one person's picks, and an anonymous reader has no "mine" to
      resolve -- offering it would produce a request the server can only
      refuse. -#}
  {% macro download_menu(id, base, label, summary, project) %}
  {%- set merged_points = project and current_user and can_download_derived -%}
  {% if merged_points or can_download_all %}
  <details class="site-menu download-menu" id="download-menu-{{ id }}"
           data-download-base="{{ base|safe }}" data-download-label="{{ label }}">
    <summary>{{ summary }}</summary>
    <ul>
      {% if merged_points %}
        <li><button type="button" data-download="level2">Picked layer points</button></li>
        <li><button type="button" data-download="derived">Derived layer points</button></li>
      {% endif %}
      {% if can_download_all %}
        <li><button type="button" data-download="track.geojson">Tracks (GeoJSON)</button></li>
      {% endif %}
    </ul>
  </details>
  {% endif %}
  {% endmacro %}

  {% if description_html %}
  {#- The project's own words, rendered from Markdown server-side (#285).
      Marked safe because `markdown::render` escaped any raw HTML in it;
      that escaping, not this filter, is what makes it safe. -#}
  <div class="catalog-description">{{ description_html|safe }}</div>
  {% endif %}

  {#- Where a failed download explains itself. Empty until something goes
      wrong, and above the group sections so the explanation is visible
      wherever on the page the menu that failed was. -#}
  <div id="download-error"></div>
  {% if warnings %}
    <div class="warning">
      <strong>{{ warnings | length }} warning(s):</strong>
      <ul>
        {% for w in warnings %}<li>{{ w }}</li>{% endfor %}
      </ul>
    </div>
  {% endif %}

  {#- The catalog-wide downloads sit with the catalog-wide control, above
      the first group heading, so "everything" reads as the outer scope of
      the per-group menus below rather than as another group. -#}
  {#- A catalog with no groups at all (#369): "Ungrouped" is then every
      radargram, so its heading says nothing and its Download menu repeats
      the catalog-wide one, which no longer needs "all" to tell it apart. -#}
  {%- set only_ungrouped = groups | length == 1 and groups[0].id == "_none" %}
  <div class="controls">
    <label>Render profile:
      <select id="index-profile-select">
        {% for p in profiles %}
        <option value="{{ p }}" {% if p == active_profile %}selected{% endif %}>{{ p }}</option>
        {% endfor %}
      </select>
    </label>
    {{ download_menu("catalog", api_base ~ "/catalog", "all radargrams",
                     "Download" if only_ungrouped else "Download all", project) }}
    {#- Every way of adding data, in one menu (#409): three buttons side by
        side read as three unrelated things. Each item keeps the condition
        it had as a button, and the menu goes when none applies. index.js
        closes it when an item is chosen. -#}
    {% if can_edit_project %}
    <details class="site-menu add-menu" id="add-data-menu">
      <summary>Add data</summary>
      <ul>
        <li><button type="button" id="add-radargram">Add processed radargram&hellip;</button></li>
        {#- A new radargram processed on the server from its raw data
            (#382), through the same dialog the viewer processes with. -#}
        <li><button type="button" id="process-new">New radargram from raw data&hellip;</button></li>
        {#- Many recordings at once, grouped and named (#382 phase 7): a
            page of its own, since a survey's worth does not fit a dialog. -#}
        <li><a href="{{ page_base|safe }}/ingest{{ profile_query }}">Add raw data in bulk&hellip;</a></li>
      </ul>
    </details>
    {#- Outside the menu: it has to stay in view while the upload runs. -#}
    <button type="button" id="add-radargram-cancel" hidden>Cancel upload</button>
    <input type="file" id="add-radargram-file" accept=".nc" hidden>
    {% endif %}
    <a class="docs-help" href="{{ docs_base|safe }}guide/gui.html"
       target="_blank" rel="noopener" title="The catalog in the documentation">?</a>
  </div>
  {% if can_edit_project %}
  <div id="add-radargram-status"></div>
  {% endif %}

  {#- "Ungrouped" is just another entry in `groups` (see routes.rs's
      index_page), not a special case: same map, same heading treatment.
      The one exception is `only_ungrouped`, above. -#}
  {#- A jump list above the first group (#309): a survey can run to dozens
      of groups, and finding one by scrolling is the problem this solves.
      Rendered only when there is a choice to make. Deliberately not
      sticky; app.css says why. -#}
  {% if groups | length > 1 %}
  <nav class="group-list" aria-label="Groups">
    <ul>
      {% for group in groups %}
      <li>
        <a href="#group-{{ group.id }}">
          <span class="group-list-label">{{ group.label }}</span>
          {#- Listed radargrams for everyone; the unlisted count only for
              someone who can already see those entries, so the badge cannot
              announce that a radargram exists. -#}
          <span class="group-list-count">{{ group.entries | length }}</span>
          {% if can_administer and group.unlisted_entries %}
          <span class="group-list-unlisted">({{ group.unlisted_entries | length }} unlisted)</span>
          {% endif %}
        </a>
      </li>
      {% endfor %}
    </ul>
  </nav>
  {% endif %}
  {% for group in groups %}
  <section class="group" id="group-{{ group.id }}">
    {#- The name, then its controls on the line beneath it (#320). They were
        pushed to opposite ends of the row, which on a wide screen left the
        name and the buttons that act on it far apart. Stacked, the buttons
        belong visibly to the heading above them and still wrap on a phone. -#}
    <div class="group-heading">
      {% if not only_ungrouped %}
      <h2>{{ group.label }}</h2>
      {% endif %}
      <div class="group-actions">
        {#- Hides this group's cards, not its map (#314): a catalog with
            hundreds of radargrams is long because of the cards, and the
            map is what tells the groups apart once they are hidden. Which
            way the page opens is a setting, project-wide and per person;
            the button changes it for this page without saving. A hidden
            card's thumbnail is never requested, so hiding also spares the
            server those overviews. -#}
        {% if group.entries or group.unlisted_entries %}
        <button type="button" class="group-toggle"
                aria-controls="group-radargrams-{{ loop.index }}"
                aria-expanded="{% if show_group_radargrams %}true{% else %}false{% endif %}"
        >{% if show_group_radargrams %}Hide all{% else %}Show all{% endif %}</button>
        {% endif %}
        {% if not only_ungrouped %}
        {{ download_menu(
             "group-" ~ loop.index,
             api_base ~ "/groups/" ~ group.id,
             group.label,
             "Download",
             project) }}
        {% endif %}
        {#- "Ungrouped" is not a group, it is the radargrams in none, so
            there is nothing about it to edit. -#}
        {% if can_edit_project and group.id != "_none" %}
        <details class="site-menu group-menu">
          <summary>Edit</summary>
          <ul>
            <li>
              <button type="button"
                      data-edit-group="{{ group.id }}"
                      data-edit-group-label="{{ group.label }}">Edit properties</button>
            </li>
          </ul>
        </details>
        {% endif %}
      </div>
    </div>
    <div class="group-map" id="group-map-{{ loop.index }}" data-group="{{ group.id }}"></div>
    <div class="group-radargrams" id="group-radargrams-{{ loop.index }}"
         {%- if not show_group_radargrams %} hidden{% endif %}>
    <ul class="card-grid">
      {% for e in group.entries %}{{ entry_card(e, active_profile, page_base, api_base) }}{% endfor %}
    </ul>
    {#- Collapsed rather than filtered away: whoever can unlist a radargram
        is the one who needs to find it again. `unlisted_entries` is only
        ever non-empty for `operator` and above (see routes.rs). -#}
    {% if group.unlisted_entries %}
    <details class="unlisted-group">
      <summary>
        {{ group.unlisted_entries | length }}
        unlisted radargram{% if group.unlisted_entries | length != 1 %}s{% endif %}
      </summary>
      <p class="hint">
        Unlisted radargrams are left out of listings and out of merged
        downloads. They are not private: anyone who knows the address can
        still open one.
      </p>
      <ul class="card-grid">
        {% for e in group.unlisted_entries %}{{ entry_card(e, active_profile, page_base, api_base) }}{% endfor %}
      </ul>
    </details>
    {% endif %}
    </div>
  </section>
  {% endfor %}

  {% if can_edit_project %}
  {% include "radargram_dialogs.html.jinja" %}
  {% endif %}

  {% if can_edit_project %}
  {#- A group's own dialog. One field today; the group override is an object
      precisely so the next group-scoped setting is a row here rather than a
      migration. -#}
  <dialog id="group-properties-dialog">
    <h2 id="group-properties-title">Edit group</h2>
    <p class="hint">
      The group's name lives with the group, not with its members, so this
      renames it everywhere at once and the radargram files are not touched.
    </p>
    <div id="group-properties-error" class="warning" hidden></div>
    <div class="properties-fields">
      <label>Name
        <input type="text" id="group-properties-name" autocomplete="off">
      </label>
      <p class="hint" id="group-properties-file"></p>
    </div>
    <p>
      <button type="button" id="group-properties-save">Save</button>
      <button type="button" id="group-properties-close">Close</button>
    </p>
  </dialog>
  {% endif %}

  {% if can_edit_project %}
  {% include "process_dialog.html.jinja" %}

  {#- Removal asks first, and says what it will do, because the two cases
      differ and the difference is not obvious from the button alone. -#}
  <dialog id="remove-dialog">
    <h2 id="remove-title">Remove radargram</h2>
    <p id="remove-explain" class="hint"></p>
    <div id="remove-error" class="warning" hidden></div>
    <p>
      <button type="button" id="remove-confirm" class="danger">Remove</button>
      <button type="button" id="remove-close">Cancel</button>
    </p>
  </dialog>
  {% endif %}

  <dialog id="group-download-dialog">
    <h2 id="group-download-title">Download layer points</h2>
    <p class="hint">
      Every interpreted radargram in scope, merged into one file: one row per
      point along each picked layer, with its depth and position. Each point
      names the radargram it came from, so the merge is reversible.
      Radargrams nobody has interpreted yet are left out.
    </p>
    {#- The same two lists, and the same resolved defaults, as the viewer's
        own download dialog (#166). -#}
    <div class="add-layer-fields">
      <label>Spacing
        <select id="group-spacing">
          {% for option in spacings %}
            <option value="{{ option.value }}"
              {%- if option.value == active_spacing %} selected{% endif %}>{{ option.label }}</option>
          {% endfor %}
        </select>
      </label>
      <label>Format
        <select id="group-format">
          {% for option in formats %}
            <option value="{{ option.value }}"
              {%- if option.value == active_format %} selected{% endif %}>{{ option.label }}</option>
          {% endfor %}
        </select>
      </label>
    </div>
    {% if can_administer %}
    {#- Shown only for the picked-points product, and only to an admin. -#}
    <label class="checkbox" id="group-every-user-row" hidden>
      <input type="checkbox" id="group-every-user">
      For every user (all contributors' points in one file)
    </label>
    {% endif %}
    {#- Shown only for the derived-layer-points product. -#}
    <label class="checkbox" id="group-include-unlisted-row" hidden>
      <input type="checkbox" id="group-include-unlisted">
      Include unlisted
    </label>
    <p>
      <button type="button" id="group-download-go">Download</button>
      <button type="button" id="group-download-close">Close</button>
    </p>
  </dialog>

  {% if not entries %}
    <p>No radargrams found.</p>
  {% endif %}
{% endblock %}
{% block extrascript %}
<script src="/static/index.js"></script>
{% if can_edit_project %}<script src="/static/process.js"></script>{% endif %}
{% if can_edit_project %}<script src="/static/radargram_edit.js"></script>{% endif %}
{% endblock %}
