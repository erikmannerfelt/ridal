{% extends "base.html.jinja" %}
{% block title %}Radargram catalog - Ridal{% endblock %}
{% block content %}
  {#- One card definition, used by both the grouped and ungrouped sections,
      so the two cannot drift apart. `profile` is a macro argument, not a
      closed-over template variable -- minijinja macros do not reliably
      see the enclosing template's context. -#}
  {% macro entry_card(e, profile) %}
  <li class="card" id="card-{{ e.radargram_id }}">
    <a class="card-link" href="/view/{{ e.radargram_id }}?profile={{ profile }}">
      <span class="card-thumb">
        {#- loading="lazy" is load-bearing, not decoration: #121 names it as
            the mechanism by which "the browser and server render-worker
            limit naturally bound initial work". Without it a 100-entry
            catalog would ask the server to render 100 overviews at once. -#}
        <img src="/api/v1/datasets/{{ e.radargram_id }}/views/standard/overview?profile={{ profile }}"
             alt="" loading="lazy" decoding="async" fetchpriority="low">
      </span>
    </a>
    {#- The name and what can be done to it on one line, under the picture.
        Two anchors to the same place rather than one wrapping both, because
        the menu is a button and a button inside a link is neither reliably
        clickable nor announced correctly. -#}
    <div class="card-heading">
      <a class="card-title" href="/view/{{ e.radargram_id }}?profile={{ profile }}">
        {{- e.effective_label -}}
      </a>
      {#- One menu per card, because what it acts on is this radargram: a
          page-level menu would have to ask which. `site-menu` is the whole
          behaviour -- app.js closes every one of them on an outside click
          or Escape -- so replace and remove (#147) are new <li>s here and
          nothing else. -#}
      {% if can_edit_project %}
      <details class="site-menu card-menu">
        <summary>Edit</summary>
        <ul>
          <li>
            <button type="button"
                    data-edit-properties="{{ e.radargram_id }}"
                    data-edit-label="{{ e.effective_label }}">Edit properties</button>
          </li>
          {#- Two different words for two different things. A radargram in
              the project is a file Ridal can delete; one in an external
              root is not, and calling both "Remove" would promise
              something about the archive that is not true. -#}
          <li>
            <button type="button" class="danger"
                    data-remove-radargram="{{ e.radargram_id }}"
                    data-remove-label="{{ e.effective_label }}"
                    data-remove-in-project="{% if e.in_project %}1{% else %}0{% endif %}">
              {%- if e.in_project %}Remove&hellip;{% else %}Stop serving&hellip;{% endif -%}
            </button>
          </li>
        </ul>
      </details>
      {% endif %}
    </div>
    {#- Only ever rendered for someone who can change it: the listing filter
        drops unlisted entries for everyone else, so this badge cannot leak
        the fact that a radargram exists. -#}
    {% if e.unlisted %}<p class="card-badge">Unlisted</p>{% endif %}
    {#- Interpretation progress takes the front row and the shape moves
        behind the toggle: the shape is the same on every card of a survey
        and answers no question anyone is asking of a catalog, while "has
        this been worked on?" is the reason to scan one.

        Only when the catalog is a project. "No picks yet" and "there is
        nowhere to save picks" are different states, and a card that says
        nothing at all is the honest rendering of the second. -#}
    <dl class="card-meta">
      <dt>ID</dt><dd><code>{{ e.radargram_id }}</code></dd>
      {% if e.line_count is not none %}
      <dt>Picked</dt>
      <dd>
        {%- if e.line_count == 0 -%}
          <span class="meta-none">None yet</span>
        {%- elif e.line_count == 1 -%}
          1 line
        {%- else -%}
          {{ e.line_count }} lines
        {%- endif -%}
      </dd>
      {% endif %}
    </dl>
    {#- Shape, path and processed-datetime are secondary lookup info, not
        scanning info -- tucked behind a details toggle so the card grid
        stays scannable. -#}
    <details class="meta-details card-more">
      <summary>More info</summary>
      <dl class="card-meta">
        <dt>Size</dt><dd>{{ e.shape[1] }} traces &times; {{ e.shape[0] }} samples</dd>
        <dt>Path</dt><dd class="path">{{ e.relative_path }}</dd>
        <dt>Processed</dt><dd>{{ e.processing_datetime_display }}</dd>
      </dl>
    </details>
  </li>
  {% endmacro %}

  {#- One menu definition for every scope on the page: the catalog-wide one
      and one per group. `base` is the API prefix the items hang off, so a
      new merged product is a line here and works at every scope at once.
      `project` is passed in for the same reason as `profile` above. -#}
  {#- Each entry is gated on the caller's download scope, and the menu
      disappears when nothing is left in it: a control that answers with an
      error is a worse way to learn about a permission than never having
      been offered one.

      "Layer points" additionally needs a signed-in user. A merged download
      covers one person's picks, and an anonymous reader has no "mine" to
      resolve -- offering it would produce a request the server can only
      refuse. -#}
  {% macro download_menu(id, base, label, summary, project) %}
  {%- set merged_points = project and current_user and can_download_derived -%}
  {% if merged_points or can_download_all %}
  <details class="site-menu download-menu" id="download-menu-{{ id }}"
           data-download-base="{{ base }}" data-download-label="{{ label }}">
    <summary>{{ summary }}</summary>
    <ul>
      {% if merged_points %}
        <li><button type="button" data-download="level2">Layer points</button></li>
      {% endif %}
      {% if can_download_all %}
        <li><button type="button" data-download="track.geojson">Tracks (GeoJSON)</button></li>
      {% endif %}
    </ul>
  </details>
  {% endif %}
  {% endmacro %}

  <h1>Radargram catalog</h1>

  {#- Where a failed download explains itself. Empty until something goes
      wrong, and above the group sections so the explanation is visible
      wherever on the page the menu that failed was. -#}
  <div id="download-error"></div>
  {% if warnings %}
    <div class="warning">
      <strong>{{ warnings | length }} warning(s):</strong>
      <ul>
        {% for w in warnings %}<li>{{ w }}</li>{% endfor %}
      </ul>
    </div>
  {% endif %}

  {#- The catalog-wide downloads sit with the catalog-wide control, above
      the first group heading, so "everything" reads as the outer scope of
      the per-group menus below rather than as another group. -#}
  <div class="controls">
    <label>Render profile:
      <select id="index-profile-select">
        {% for p in profiles %}
        <option value="{{ p }}" {% if p == active_profile %}selected{% endif %}>{{ p }}</option>
        {% endfor %}
      </select>
    </label>
    {{ download_menu("catalog", "/api/v1/catalog", "all radargrams",
                     "Download all", project) }}
    {#- A plain button rather than a menu: one action, and hiding a single
        item behind a disclosure is a click for nothing. -#}
    {% if can_edit_project %}
    <button type="button" id="add-radargram">Add radargram&hellip;</button>
    <input type="file" id="add-radargram-file" accept=".nc" hidden>
    {% endif %}
  </div>
  {% if can_edit_project %}
  <div id="add-radargram-status"></div>
  {% endif %}

  {#- "Ungrouped" is just another entry in `groups` (see routes.rs's
      index_page), not a special case: same map, same heading treatment,
      always shown even when it's the only section on the page. -#}
  {% for group in groups %}
  <section class="group">
    {#- The heading and its downloads on one line: the menu acts on this
        group, and putting it anywhere else would leave that ambiguous once
        a page has several. -#}
    <div class="group-heading">
      <h2>{{ group.label }}</h2>
      {#- Controls to the right of the name, the same way a card puts its
          menu opposite its title. -#}
      <div class="group-actions">
        {{ download_menu(
             "group-" ~ loop.index,
             "/api/v1/groups/" ~ group.id,
             group.label,
             "Download",
             project) }}
        {#- "Ungrouped" is not a group, it is the radargrams in none, so
            there is nothing about it to edit. -#}
        {% if can_edit_project and group.id != "_none" %}
        <details class="site-menu group-menu">
          <summary>Edit</summary>
          <ul>
            <li>
              <button type="button"
                      data-edit-group="{{ group.id }}"
                      data-edit-group-label="{{ group.label }}">Edit properties</button>
            </li>
          </ul>
        </details>
        {% endif %}
      </div>
    </div>
    <div class="group-map" id="group-map-{{ loop.index }}" data-group="{{ group.id }}"></div>
    <ul class="card-grid">
      {% for e in group.entries %}{{ entry_card(e, active_profile) }}{% endfor %}
    </ul>
    {#- Collapsed rather than filtered away: whoever can unlist a radargram
        is the one who needs to find it again. `unlisted_entries` is only
        ever non-empty for `operator` and above (see routes.rs). -#}
    {% if group.unlisted_entries %}
    <details class="unlisted-group">
      <summary>
        {{ group.unlisted_entries | length }}
        unlisted radargram{% if group.unlisted_entries | length != 1 %}s{% endif %}
      </summary>
      <p class="hint">
        Unlisted radargrams are left out of listings and out of merged
        downloads. They are not private: anyone who knows the address can
        still open one.
      </p>
      <ul class="card-grid">
        {% for e in group.unlisted_entries %}{{ entry_card(e, active_profile) }}{% endfor %}
      </ul>
    </details>
    {% endif %}
  </section>
  {% endfor %}

  {% if can_edit_project %}
  {#- One dialog for every card, filled in from the API when it opens: the
      values it shows include what each field would be *without* its
      override, which the card does not know and which is what makes
      "revert to the file" honest rather than a leap of faith. -#}
  <dialog id="properties-dialog">
    <h2 id="properties-title">Edit properties</h2>
    <p class="hint">
      These are the project's own labels. They sit over what the radargram
      file says and never change the file, so reprocessing it does not lose
      them — and reverting a field puts the file's own value back.
    </p>
    <p id="properties-error" class="warning" hidden></p>
    <div class="properties-fields">
      <label>Name
        <input type="text" id="properties-display-name" autocomplete="off">
      </label>
      <p class="hint" id="properties-display-name-file"></p>

      {#- Membership, and only membership. Picking an existing group joins
          it; renaming one is the group's own dialog, reached from its
          heading. The first version of this was a text box with a datalist,
          where typing over a chosen name silently forked a new group
          instead of renaming the old one -- two operations that looked
          identical and were not. -#}
      <label>Group
        <select id="properties-group-choice">
          <option value="inherit">Use the radargram's own</option>
          <option value="ungrouped">No group</option>
          <option value="new">New group&hellip;</option>
        </select>
      </label>
      <label id="properties-group-row">New group's name
        <input type="text" id="properties-group-name" autocomplete="off">
      </label>
      <p class="hint" id="properties-group-file"></p>

      <label class="checkbox">
        <input type="checkbox" id="properties-unlisted">
        Unlisted
      </label>
      <p class="hint">
        Leaves this radargram out of listings and out of merged downloads.
        It is not private: anyone who knows the address can still open it.
      </p>
    </div>
    <p>
      <button type="button" id="properties-save">Save</button>
      <button type="button" id="properties-close">Close</button>
    </p>
  </dialog>
  {% endif %}

  {% if can_edit_project %}
  {#- A group's own dialog. One field today; the group override is an object
      precisely so the next group-scoped setting is a row here rather than a
      migration. -#}
  <dialog id="group-properties-dialog">
    <h2 id="group-properties-title">Edit group</h2>
    <p class="hint">
      The group's name lives with the group, not with its members, so this
      renames it everywhere at once and the radargram files are not touched.
    </p>
    <p id="group-properties-error" class="warning" hidden></p>
    <div class="properties-fields">
      <label>Name
        <input type="text" id="group-properties-name" autocomplete="off">
      </label>
      <p class="hint" id="group-properties-file"></p>
    </div>
    <p>
      <button type="button" id="group-properties-save">Save</button>
      <button type="button" id="group-properties-close">Close</button>
    </p>
  </dialog>
  {% endif %}

  {% if can_edit_project %}
  {#- Removal asks first, and says what it will do, because the two cases
      differ and the difference is not obvious from the button alone. -#}
  <dialog id="remove-dialog">
    <h2 id="remove-title">Remove radargram</h2>
    <p id="remove-explain" class="hint"></p>
    <p id="remove-error" class="warning" hidden></p>
    <p>
      <button type="button" id="remove-confirm" class="danger">Remove</button>
      <button type="button" id="remove-close">Cancel</button>
    </p>
  </dialog>
  {% endif %}

  <dialog id="group-download-dialog">
    <h2 id="group-download-title">Download layer points</h2>
    <p class="hint">
      Every interpreted radargram in scope, merged into one file: one row per
      point along each picked layer, with its depth and position. Each point
      names the radargram it came from, so the merge is reversible.
      Radargrams nobody has interpreted yet are left out.
    </p>
    <div class="add-layer-fields">
      <label>Spacing
        <select id="group-spacing">
          <option value="auto" selected>Auto (from trace spacing)</option>
          <option value="1">1 m</option>
          <option value="5">5 m</option>
          <option value="10">10 m</option>
          <option value="25">25 m</option>
          <option value="per-trace">Every trace</option>
          <option value="vertices">Picked vertices only</option>
        </select>
      </label>
      <label>Format
        <select id="group-format">
          <option value="geojson" selected>GeoJSON (WGS84)</option>
          <option value="geojson-native">GeoJSON (native CRS)</option>
          <option value="csv">CSV</option>
        </select>
      </label>
    </div>
    <p>
      <button type="button" id="group-download-go">Download</button>
      <button type="button" id="group-download-close">Close</button>
    </p>
  </dialog>

  {% if not entries %}
    <p>No radargrams found.</p>
  {% endif %}
{% endblock %}
{% block extrascript %}
<script src="/static/index.js"></script>
{% endblock %}
