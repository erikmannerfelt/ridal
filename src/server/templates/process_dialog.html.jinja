{#- Processing on the server (#382), shared by the viewer and the catalog.
    Two stages, driven by process.js: raw data in (a new radargram from the
    catalog, or a served one that has none yet), then steps in and a draft
    out. The viewer of a radargram with raw data starts at the second. -#}
<dialog id="process-dialog" class="process-dialog">
  <h2 id="process-title">Process</h2>
  <p id="process-status" class="hint"></p>
  <section id="process-raw" hidden>
    <label id="process-id-label">Radargram id
      <input type="text" id="process-id" autocomplete="off" spellcheck="false">
    </label>
    <p>
      <button type="button" id="process-choose">Choose raw files&hellip;</button>
      <input type="file" id="process-files" multiple hidden
             accept=".rad,.rd3,.rd7,.cor,.hd,.dt1,.gp2,.dzt,.dzg,.dzx">
    </p>
    <ul id="process-file-list" class="process-files"></ul>
    {#- Left empty, the positions go in the UTM zone that suits them best,
        as `ridal process` does without `--crs`. -#}
    <label>CRS for the positions
      <input type="text" id="process-crs" autocomplete="off" spellcheck="false"
             placeholder="Automatic: the best UTM zone for the track">
    </label>
  </section>
  {#- In both stages: a new radargram can start in a profile, and one being
      processed can be moved to another. -#}
  <label>Processing profile
    <select id="process-profile">
      <option value="">None</option>
    </select>
  </label>
  <section id="process-draft">
    {#- Where the radargram stands against its processing profile, and the
        one-click way back to it when it is stale. -#}
    <div id="process-standing" class="process-standing" hidden>
      <p id="process-standing-text"></p>
      <button type="button" id="process-use-profile" hidden>Use the profile's steps</button>
    </div>
    <ul id="process-recordings" class="process-files"></ul>
    <p class="process-steps-help">
      <button type="button" id="process-default-steps"
              data-steps="{{ default_processing_steps | join('\n') }}">Replace with default steps</button>
      <a href="{{ docs_base|safe }}reference/steps.html" target="_blank" rel="noopener">All processing steps</a>
      &middot;
      <a href="{{ docs_base|safe }}guide/processing.html" target="_blank" rel="noopener">Processing guide</a>
    </p>
    {#- Only for a radargram in a processing profile: its own steps, run
        before the profile's. Kept in a box of their own so it is plain
        which steps belong to the radargram and which to the profile. -#}
    <div id="process-pre" class="process-pre" hidden>
      <label class="process-steps">Steps before the profile, one per line
        <textarea id="process-pre-steps" rows="2" spellcheck="false"
                  placeholder="subset(0 2000)"></textarea>
      </label>
      <p class="hint">
        This radargram's own steps, run first, before the profile's steps
        below. Only <code>subset</code> and <code>remove_traces</code>, to
        choose its traces and samples. Saved with the radargram when you
        process, so the profile runs them too.
      </p>
    </div>
    <label class="process-steps"><span id="process-steps-label">Steps, one per line</span>
      <textarea id="process-steps" rows="8" spellcheck="false"
                placeholder="As `ridal steps` lists them, e.g.&#10;zero_corr&#10;dewow&#10;bandpass(0.1 0.9)"></textarea>
    </label>
    <label>Medium velocity (m/ns)
      <input type="number" id="process-velocity" step="0.001" min="0.01" value="0.168">
    </label>
  </section>
  <div id="process-error" class="warning" hidden></div>
  <figure id="process-result" class="process-result" hidden>
    {#- The render profiles, starting at the person's own. On a page with
        its own render profile select, process.js follows that instead. -#}
    <label>Render profile
      <select id="process-render">
        {%- for p in profiles %}
        <option value="{{ p }}" {% if p == active_profile %}selected{% endif %}>{{ p }}</option>
        {%- endfor %}
      </select>
    </label>
    <img id="process-image" alt="">
    <figcaption id="process-caption"></figcaption>
  </figure>
  <p id="process-headline"></p>
  <div id="process-detail"></div>
  {#- What is happening now, beside the buttons that started it, both kept
      in view at the foot of the dialog however long it has grown. -#}
  <div class="process-footer">
  <p id="process-progress" class="hint" aria-live="polite"></p>
  <p>
    <button type="button" id="process-upload" hidden disabled>Upload</button>
    <button type="button" id="process-cancel-upload" hidden>Cancel upload</button>
    <button type="button" id="process-run">Process</button>
    <button type="button" id="process-toggle" hidden>Show current</button>
    <button type="button" id="process-commit" hidden>Apply</button>
    <button type="button" id="process-confirm" class="danger" hidden>Apply and close</button>
    <button type="button" id="process-close">Close</button>
  </p>
  </div>
</dialog>
