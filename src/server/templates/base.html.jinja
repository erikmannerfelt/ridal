<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}Ridal{% endblock %}</title>
  <link rel="stylesheet" href="/static/leaflet.css">
  <style>
    :root { color-scheme: light dark; }
    body { font-family: system-ui, sans-serif; margin: 0; padding: 0; }
    header { padding: 0.75rem 1rem; border-bottom: 1px solid #8884; display: flex; align-items: center; gap: 1rem; }
    header a { text-decoration: none; font-weight: 600; }
    main { padding: 1rem; }
    .warning { background: #fdf0d5; border: 1px solid #e0b23c; padding: 0.5rem 0.75rem; border-radius: 4px; margin-bottom: 0.75rem; }
  </style>
  {% block extrahead %}{% endblock %}
</head>
<body>
  <header>
    <a href="/">Ridal</a>
  </header>
  <main>
    {% block content %}{% endblock %}
  </main>
  <script src="/static/leaflet.js"></script>
  {% block extrascript %}{% endblock %}
</body>
</html>
