{% extends "base.html.jinja" %}
{% block title %}Layers - Ridal{% endblock %}
{% block content %}
  <h1>Layers</h1>
  <p class="lede">
    A layer is what a picked line belongs to. Its <strong>id</strong> is
    written into every pick and exported as the <code>layer</code> column;
    its <strong>name</strong> is only for display, so renaming is free.
  </p>

  {% if not project %}
    <div class="warning">
      <p>
        This catalog is not a Ridal project, so it has no layer definitions.
        Run <code>ridal project init</code> in the directory being served and
        restart to define some.
      </p>
    </div>
  {% elif not writable %}
    {#- Shown and explained rather than hidden, following the same rule as
        the picking toolbar: a missing control reads as a missing feature.
        Reading has to reach further down than writing, because the names
        and colours are what make someone else's picks legible. -#}
    <div class="warning">
      {% if read_only_server %}
        <p>This server is read-only. Layers are shown but cannot be changed.</p>
      {% else %}
        <p>
          Changing the layer vocabulary needs the <code>operator</code>
          role &mdash; you are
          {% if current_user %}
            <code>{{ current_user }}</code> ({{ current_role }}).
          {% else %}
            not signed in.
          {% endif %}
          {% if can_pick %}
            You can still use these layers on your own picks.
          {% endif %}
        </p>
      {% endif %}
    </div>
  {% endif %}

  <div id="layers-error" class="warning" hidden></div>

  <table id="layers-table" class="layers-table">
    <thead>
      <tr>
        <th scope="col">Colour</th>
        <th scope="col">ID</th>
        <th scope="col">Name</th>
        <th scope="col">Description</th>
        {#- The guardrail is off by default, so the column asks the question
            in the direction the answer is usually "no". -#}
        <th scope="col" title="Allow a line in this layer to double back, so it has more than one depth at a position. Such a layer is exported as its picked vertices rather than at even spacing.">Overhangs</th>
        <th scope="col">Used by</th>
        <th scope="col"><span class="visually-hidden">Actions</span></th>
      </tr>
    </thead>
    <tbody></tbody>
  </table>

  <p id="layers-empty" class="empty" hidden>No layers defined yet.</p>

  {% if writable %}
    {#- `novalidate`: the browser's own bubbles say "Please match the requested
      format" without saying what the format is or why. layers.js validates
      instead, into the same error box every other failure on this page uses.
      `required`/`pattern` stay as a fallback for the no-JS case. -#}
    <form id="add-layer" class="add-layer" novalidate>
      <h2>Add a layer</h2>
      <p class="hint">
        The id cannot be changed afterwards, because existing picks refer to
        it. Lowercase letters, digits, <code>-</code> and <code>_</code>.
      </p>
      <div class="add-layer-fields">
        <label>ID
          <input type="text" name="id" required pattern="[a-z0-9_\-]+"
                 placeholder="bed" autocomplete="off">
        </label>
        <label>Name
          <input type="text" name="name" required placeholder="Bed" autocomplete="off">
        </label>
        <label>Colour
          <input type="color" name="color" value="#e6194b">
        </label>
        <label>Description
          <input type="text" name="description" placeholder="optional" autocomplete="off">
        </label>
        <label class="checkbox">
          <input type="checkbox" name="allow_overhangs">
          Allow overhangs
        </label>
      </div>
      <button type="submit">Add layer</button>
    </form>
  {% endif %}

  <div id="undefined-labels" hidden>
    <h2>Labels in use with no definition</h2>
    <p class="hint">
      These appear on stored picks but are not defined above, so the viewer
      draws them without a colour. Defining one adopts the existing picks;
      they are never modified either way.
    </p>
    <ul id="undefined-list"></ul>
  </div>

  {#- Derived items (#209). The viewer's layer panel is the main place to
      author these; this is the other place, so a project can be managed
      without opening a radargram. The live preview lives in the viewer only,
      because it needs one. -#}
  <section id="derived-section">
    <h2>Derived items</h2>
    <p class="lede">
      Named expressions over the layers above, for example
      <code>median(bed)</code> for a consensus line. They appear in the
      viewer's layer panel and can be exported. The live preview is in the
      viewer, which has a radargram to draw against; here an expression is
      checked when you save.
    </p>
    <div id="derived-error" class="warning" hidden></div>
    <div id="derived-actions"></div>
    <table id="derived-table" class="layers-table">
      <thead>
        <tr>
          <th scope="col">Colour</th>
          <th scope="col">ID</th>
          <th scope="col">Name</th>
          <th scope="col">Kind</th>
          <th scope="col">Unit</th>
          <th scope="col">Expression</th>
          <th scope="col" title="Whether the viewer draws it when it opens.">Shown</th>
          <th scope="col" title="Whether it appears in the viewer's layer panel. An intermediate layer can be unlisted to keep the panel short.">Listed</th>
          <th scope="col" title="How many other derived items use this one in an expression. Deleting it would be refused while any do.">Used by</th>
          <th scope="col" title="Whose picks feed it: the viewer's own, or every contributor's once released.">Audience</th>
          <th scope="col"><span class="visually-hidden">Actions</span></th>
        </tr>
      </thead>
      <tbody></tbody>
    </table>
    <p id="derived-empty" class="empty" hidden>No derived items defined yet.</p>
  </section>
{% endblock %}
{% block extrascript %}
  {#- The only inline JS on this page: a server-side value layers.js cannot
      know. Matches the viewer's convention so both pages read the same way. -#}
  <script>
    window.RIDAL_LAYERS = { writable: {% if writable %}true{% else %}false{% endif %} };
  </script>
  <script src="/static/layers.js"></script>
{% endblock %}
