{% extends "base.html.jinja" %}
{% block title %}Processing - Ridal{% endblock %}
{% block content %}
  <h1>Processing</h1>
  <p class="lede">
    A <strong>processing profile</strong> is processing that many radargrams
    share: a list of steps and a medium velocity. It is not a group, and its
    radargrams may be in any number of groups. Each radargram in a profile is
    marked <strong>stale</strong> when it was processed some other way than
    the profile and its raw data say now. <strong>Process out-of-date
    radargrams</strong> on a profile processes every one that is stale or
    not processed yet and applies each; <strong>Process&hellip;</strong> on
    one radargram lets you look at the result before applying it.
  </p>

  {% if not project %}
    <div class="warning">
      <p>
        This catalog is not a Ridal project, so it has no processing
        profiles. Run <code>ridal project init</code> in the directory being
        served and restart to make some.
      </p>
    </div>
  {% elif not writable %}
    {#- Shown and explained rather than hidden, as on the layers page. -#}
    <div class="warning">
      {% if read_only_server %}
        <p>This server is read-only. Profiles are shown but cannot be changed.</p>
      {% else %}
        <p>
          Changing processing profiles needs the <code>operator</code> role
          &mdash; you are
          {% if current_user %}
            <code>{{ current_user }}</code> ({{ current_role }}).
          {% else %}
            not signed in.
          {% endif %}
        </p>
      {% endif %}
    </div>
  {% endif %}

  {% if project and writable %}
  <p>
    <a href="{{ page_base|safe }}/ingest{{ profile_query }}">Add raw data in bulk&hellip;</a>
    for many recordings at once: grouped into radargrams, named, and
    processed now or later.
  </p>
  {% endif %}

  <div id="processing-error" class="warning" hidden></div>
  <p id="processing-empty" class="hint" hidden>
    No processing profiles yet.
  </p>
  <div id="processing-profiles"
       data-writable="{% if writable %}true{% else %}false{% endif %}"></div>

  {% if project %}
  {#- With processing optional, raw data nobody has processed would be
      invisible: it has no card in the catalog and may be in no profile. -#}
  <section class="processing-unprocessed" id="raw-unprocessed" hidden>
    <h2>Raw data not processed yet</h2>
    <p class="hint">
      Radargrams the project has raw data for but no processed file:
      uploaded and not processed yet, or left behind when processing
      stopped. <strong>Process&hellip;</strong> one to look at it before it
      is added to the catalog, or put it in a profile and process that
      profile's out-of-date radargrams.
    </p>
    <div id="raw-unprocessed-list"></div>
  </section>
  {% endif %}

  {% if project and writable %}
  <details class="processing-new" id="processing-new">
    <summary>New processing profile</summary>
    {#- The name comes first because the id is derived from it, as on the
        settings page: the id box's placeholder shows what will be stored
        if it is left alone. -#}
    <form id="processing-new-form">
      <label>Name <input name="name" required placeholder="Svalbard, 100 MHz"></label>
      <label>ID (from the name)
        <input name="id" pattern="[a-z0-9][a-z0-9_-]*" placeholder="svalbard-100-mhz"
               autocomplete="off" autocapitalize="none" spellcheck="false"></label>
      <label class="process-steps">Steps, one per line
        <textarea name="steps" rows="6" spellcheck="false"></textarea></label>
      <label>Medium velocity (m/ns)
        <input name="medium_velocity" type="number" step="0.001" min="0.01" value="0.168"></label>
      <p><button type="submit">Create</button></p>
    </form>
  </details>

  {% endif %}

  {% if project %}
  {#- DEMs are the project's, not a profile's: uploaded once here, and each
      radargram linked to one in its Process dialog. `#dems` is where that
      dialog's "Add a DEM" link lands. -#}
  <section class="processing-dems" id="dems">
    <h2>DEMs</h2>
    <p class="hint">
      A DEM gives processing the surface elevation along each radargram. Add
      one here, then choose it in a radargram's <strong>Process&hellip;</strong>
      dialog. A DEM that radargrams use cannot be deleted or given another
      file; add the new one beside it and choose that instead.
    </p>
    <p id="dems-empty" class="hint" hidden>No DEMs yet.</p>
    <div id="dems-list"></div>
    {% if writable %}
    <form id="dems-form">
      <fieldset class="processing-add">
        <legend>Add a DEM</legend>
        <label>Name <input name="name" required placeholder="Svalbard DEM 2008"></label>
        <label>ID (from the name)
          <input name="id" pattern="[a-z0-9][a-z0-9_-]*" placeholder="svalbard-dem-2008"
                 autocomplete="off" autocapitalize="none" spellcheck="false"></label>
        <label>File, a raster such as a GeoTIFF
          <input name="file" type="file" required accept=".tif,.tiff,.vrt,.img,.asc,.nc"></label>
        <p>
          <button type="submit" id="dems-add">Add</button>
          <button type="button" id="dems-cancel" hidden>Cancel upload</button>
        </p>
        <p id="dems-progress" class="hint" aria-live="polite"></p>
      </fieldset>
    </form>
    {% endif %}
    <dialog id="dems-users" class="dems-users">
      <h2 id="dems-users-title"></h2>
      <ul id="dems-users-list"></ul>
      <p><button type="button" id="dems-users-close">Close</button></p>
    </dialog>
  </section>
  {% endif %}

  {% if project and writable %}
  {#- Every batch that reprocessed a profile, newest first. -#}
  <details class="processing-history" id="processing-history">
    <summary>Recent batches</summary>
    <div id="processing-history-list"></div>
  </details>

  {% include "process_dialog.html.jinja" %}
  {% endif %}
{% endblock %}

{% block extrascript %}
<script src="/static/processing.js"></script>
{% if project and writable %}<script src="/static/process.js"></script>{% endif %}
{% endblock %}
