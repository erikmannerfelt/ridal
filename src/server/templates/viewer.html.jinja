{% extends "base.html.jinja" %}
{% block title %}{{ effective_label }} - Ridal{% endblock %}
{% block content %}
  {#- Carries the active profile back to the catalog, so a round trip
      viewer -> catalog -> viewer stays in the profile you were browsing
      in rather than silently resetting to the default. -#}
  <p><a class="back-link" href="{{ page_base|safe }}/?profile={{ active_profile }}#card-{{ radargram_id }}">
    <span aria-hidden="true">&larr;</span> Back to catalog</a></p>
  <h1>{{ effective_label }}{% if group_name %} (Group: {{ group_name }}){% endif %}</h1>
  <table class="meta">
    <tr>
      <th>Radargram ID</th>
      <td>
        <code>{{ radargram_id }}</code>
        (Rev. {{ revision_short }}; processed {{ processing_datetime }})
      </td>
    </tr>
  </table>

  <div class="controls">
    {#- Everything about how the radargram is drawn, without changing where
        anything is: the render profile, the horizontal scale, and the
        contrast and brightness sliders that depend on the profile (they
        are remembered per profile and switched off for colormapped ones),
        which is why they share a menu with it. Topographic correction stays
        in the row: it moves the picks, so it is more than a display
        setting. The summary names the profile, so the most-used of these
        is readable without opening the menu.

        The sliders are the browser's work on the tiles it already has. No
        request reaches the server, so a room full of people dragging them
        costs nothing there; the price is that they cannot bring back what
        the render profile already clipped. A server-side dial that can is
        #297. Their rows are hidden until viewer.js wires them, so a page
        without JavaScript does not offer dead controls. -#}
    <details class="site-menu display-menu" id="display-menu">
      <summary>Display: {{ active_label }}</summary>
      {#- `autocomplete="off"` on the profile, the scale and the topographic
          correction: what the page opens with is the server's to say, and a
          browser restores a control's last value on a reload, over it. After
          an edit to the radargram's horizontal scale the page reloaded at the
          old one, and the topographic correction came back ticked over an
          uncorrected view. -#}
      <ul>
        <li><label>Render profile
          <select id="profile-select" autocomplete="off">
            {% for g in profile_groups %}
            <optgroup label="{{ g.label }}">
              {% for p in g.profiles %}
              <option value="{{ p.name }}"{% if p.name == active_profile %} selected{% endif %}{% if p.colormap %} data-colormap{% endif %}>{{ p.label }}</option>
              {% endfor %}
            </optgroup>
            {% endfor %}
          </select>
        </label></li>
        {#- The profile editor (#183), for whoever may keep a profile of
            their own or edit the project's. -#}
        {% if edit_personal or edit_project %}
        <li><button type="button" id="profile-edit">Edit profile&hellip;</button></li>
        {% endif %}
        {#- Options come from the server so the project's default always
            has an entry to select; a hardcoded list here could drift from
            the one the settings page validates against. -#}
        <li><label>Horizontal scale
          <select id="xscale-select" autocomplete="off">
            {% for s in x_scales %}
            <option value="{{ s.text }}" {% if s.value == active_x_scale %}selected{% endif %}>{{ s.label }}</option>
            {% endfor %}
          </select>
        </label></li>
        <li class="display-adjust" hidden><label>Contrast
          <input type="range" id="display-contrast" min="-2" max="2" step="0.05" value="0">
          <output id="display-contrast-value" for="display-contrast">1.00</output>
        </label></li>
        <li class="display-adjust" hidden><label>Brightness
          <input type="range" id="display-brightness" min="-2" max="2" step="0.05" value="0">
          <output id="display-brightness-value" for="display-brightness">1.00</output>
        </label></li>
        <li class="display-adjust" hidden><button type="button" id="display-reset">Reset contrast and brightness</button></li>
        <li class="display-adjust hint" id="display-note" hidden>Contrast and brightness only change what is drawn here: downloads use the render profile as it is.</li>
        <li class="display-smoothing" hidden><label>
          <input type="checkbox" id="display-smoothing" checked>
          Smooth when zoomed in
        </label></li>
        {#- Hide the radargram image, leaving the picks, derived layers and
            fills over the empty map (#230). A pick in a colour close to the
            reflector it follows is hard to see against it, and this is the
            cheapest way to check one. A display setting like the rest of
            this menu (#439); `autocomplete="off"` because it is not
            remembered, so a reload must not restore it unticked. -#}
        <li class="display-radargram" hidden><label>
          <input type="checkbox" id="radargram-visible" checked autocomplete="off">
          Show radargram
        </label></li>
      </ul>
    </details>
    {#- Disabled until the on-load availability check resolves, with the
        reason it cannot be offered (if any) as its title -- #168's rule
        that unavailability must never be silent. -#}
    <label class="checkbox" id="topo-toggle-row">
      <input type="checkbox" id="topo-toggle" autocomplete="off" disabled title="Checking availability&hellip;">
      Topographic correction
    </label>
    <button id="topo-recentre" type="button" hidden
            title="Fit the view to the data over the traces currently on screen -- the way back if a pan has drifted into empty space above or below the corrected surface.">
      Recentre
    </button>
    <button id="metadata-button" type="button">Metadata</button>
    {#- The trace view (#181). A plain toggle button for now: the
        interaction (click the radargram to choose the trace) is the part
        that was decided, while how the panel should present itself is
        explicitly a prototype to refine. Hidden until viewer.js wires it,
        so a page without JavaScript does not offer a dead control. -#}
    <button id="trace-toggle" type="button" aria-pressed="false" hidden
            title="Show a single trace beside the radargram. Click the radargram to choose which trace.">Trace view</button>
    {#- A menu rather than a button: there are five things to download and
        they are not variations of one another. Lives in this row, not the
        picking toolbar, because a radargram, its track and an image are
        downloadable from a read-only catalog with no project at all.

        Each entry is gated on the caller's download scope, and the menu
        itself disappears when nothing is left in it. An entry that answers
        with an error dialog is a worse way to learn about a permission
        than never having been offered it -- the opposite of the rule the
        picking toolbar follows below, and deliberately so: picking is the
        point of the page, so its absence needs explaining, while a
        download someone was never granted is not a feature they are
        missing.

        The two pick downloads additionally need a signed-in user, because
        both are downloads of *your own* picks and an anonymous reader has
        none to name. -#}
    {%- set own_picks = project and current_user -%}
    {%- set show_download = (own_picks and (can_download_derived or can_download_picks))
                            or can_download_derived or can_download_all -%}
    {% if show_download %}
    <details class="site-menu download-menu" id="download-menu">
      <summary>Download</summary>
      <ul>
        {% if own_picks and can_download_derived %}
          <li><button type="button" id="dl-points">Picked layer points</button></li>
        {% endif %}
        {% if can_download_derived %}
          <li><button type="button" id="dl-derived-points">Derived layer points</button></li>
        {% endif %}
        {% if own_picks and can_download_picks %}
          <li><button type="button" id="dl-raw">Raw picks (gprinterp)</button></li>
        {% endif %}
        {% if can_download_all %}
          <li><button type="button" id="dl-track">Track (GeoJSON)</button></li>
        {% endif %}
        {% if can_download_derived %}
          <li><button type="button" id="dl-image">Rendered image</button></li>
          <li><button type="button" id="dl-figure">Figure&hellip;</button></li>
        {% endif %}
        {% if can_download_all %}
          <li><button type="button" id="dl-radargram">Radargram (NetCDF)</button></li>
        {% endif %}
        {#- The files it was processed from (#460), when the project has
            them; `has_raw_data` is false for anyone without `all`. -#}
        {% if has_raw_data %}
          <li><button type="button" id="dl-raw-data">Raw data (zip)</button></li>
        {% endif %}
      </ul>
    </details>
    {% endif %}
    {#- The same edits as a catalog card's Edit menu (#431), for the
        radargram on screen, less removing it: that would leave this page
        showing nothing. For an operator, as there; replacing and processing
        only for a radargram the project owns, since both write its file. -#}
    {% if project and can_operate %}
    <details class="site-menu edit-menu" id="edit-menu">
      <summary>Edit</summary>
      <ul>
        <li>
          <button type="button"
                  data-edit-properties="{{ radargram_id }}"
                  data-edit-label="{{ effective_label }}">Edit properties</button>
        </li>
        {% if radargram_in_project %}
        <li>
          <button type="button"
                  data-replace-radargram="{{ radargram_id }}"
                  data-replace-label="{{ effective_label }}">Replace with a new version&hellip;</button>
        </li>
        {#- Processing on the server (#382). Hidden until process.js has
            asked whether the project has this radargram's raw data: with
            it the button processes, without it it attaches some. -#}
        <li>
          <button type="button" id="process-open" hidden>Process&hellip;</button>
        </li>
        {% endif %}
      </ul>
    </details>
    {% endif %}
    <a class="docs-help" href="{{ docs_base|safe }}guide/gui.html"
       target="_blank" rel="noopener" title="The viewer in the documentation">?</a>
    <span id="cursor-readout"></span>
  </div>

  {#- Where a failed download explains itself, rather than the browser
      leaving this page to render the error envelope as a document. -#}
  <div id="download-error"></div>

  {#- Someone is processing this radargram (#382): advisory, so that two
      people do not process the same one, not a lock. app.js fills it in
      for everyone, as the catalog's badge does. -#}
  {% if project %}
  <p id="processing-activity" class="processing-activity" role="status"
     data-radargram="{{ radargram_id }}" hidden></p>
  {% endif %}

  {#- The picking toolbar. Rendered even when the catalog is not a writable
      project, in which case it explains why rather than vanishing: a missing
      control reads as a missing feature. -#}
  <div class="controls picker-controls" id="picker-controls">
    {% if writable %}
      {#- The swatch sits inside the label so it groups with the select
          rather than with the button after it. `aria-hidden` because the
          colour repeats what the option text already says -- it is a
          reminder, not information of its own. -#}
      <label>Layer:
        <span class="layer-swatch layer-swatch-inline" id="pick-layer-swatch"
              aria-hidden="true"></span>
        <select id="pick-layer"><option value="">Loading&hellip;</option></select>
      </label>
      {#- Hiding the interpretations to look at the radargram underneath
          (#143). A toggle rather than a mode: it changes what is drawn and
          nothing else, and picking brings them back by itself, since
          drawing over lines you cannot see is not a state worth allowing.

          Inside the writable branch because this is where picks are drawn
          at all -- a reader who is not signed in has none on screen to
          hide. `aria-pressed` carries the state for a screen reader; the
          label says what pressing it will do. -#}
      <button id="pick-visibility" type="button"
              aria-pressed="{% if show_picks %}true{% else %}false{% endif %}"
              title="Show or hide the picked lines over the radargram. Starting to pick shows them again."
        >{% if show_picks %}Hide picks{% else %}Show picks{% endif %}</button>
      {#- One button for the whole line-drawing gesture (#240). It starts a
          line, becomes Finish line while one is in progress, and finishing
          returns to selection. There is no picking mode to enter or leave,
          so there is nothing for the label to fail to explain. Double-click
          the last point is the second way to finish, hence the title. -#}
      <button id="pick-toggle" type="button" aria-pressed="false"
              title="Add a new line. While drawing, Finish line (or a double-click on the last point) completes it.">Add line</button>
      <button id="pick-undo" type="button" disabled>Undo vertex</button>
      <button id="pick-save" type="button" disabled>Save</button>
      <span id="pick-status" class="pick-status"></span>
    {% else %}
      <span class="pick-status">
        {% if not project %}
          Not a Ridal project, so there is nowhere to save picks.
          Run <code>ridal project init</code> and restart.
        {% elif read_only_server %}
          This server is read-only, so picks cannot be saved.
        {% elif not current_user %}
          <a href="/login">Sign in</a> to draw picks of your own. Everyone
          else's are shown either way.
        {% else %}
          Drawing picks needs the <code>picker</code> role, and
          <code>{{ current_user }}</code> is a {{ current_role }}.
        {% endif %}
      </span>
    {% endif %}
  </div>

  {#- What carrying these picks onto this revision cost (#148).
      A banner rather than the toast: the toast is for something that just
      happened and goes away, and this is a standing condition of what is
      on screen. It stays until the picks shown are the picks as drawn. -#}
  <div class="carry-banner" id="carry-banner" role="status" aria-live="polite" hidden>
    <strong id="carry-tier"></strong>
    <span id="carry-headline"></span>
    <details id="carry-detail" hidden>
      <summary>What moved</summary>
      <div id="carry-detail-body"></div>
    </details>
  </div>

  {#- Appears when a stored line is clicked. A sibling of the toolbar rather
      than a child: it acts on one existing line rather than on the drawing
      session, and showing it only when relevant is what makes "click a line
      to edit it" discoverable.

      picker.js moves this into a Leaflet control over the map (#239). In
      flow it grew the controls block the moment a line was selected and
      shrank it on deselect, which shifted the radargram under the pointer.
      Rendered here rather than built in JS so a page without JavaScript
      still has the markup, hidden, in its place. -#}
  {% if writable %}
  <div class="controls picker-selection" id="pick-selection" hidden>
    <strong>Selected line</strong>
    <label>Layer:
      <span class="layer-swatch layer-swatch-inline" id="pick-selected-swatch"
            aria-hidden="true"></span>
      <select id="pick-selected-layer"></select>
    </label>
    <button id="pick-delete" type="button" class="danger">Delete line</button>
    {#- The instructions wrap to several lines on a phone, where the overlay
        would otherwise cover much of the map. A disclosure: open by default
        on a wide screen, closed on a narrow one, so a phone shows only the
        summary until asked. picker.js sets `open` from the same breakpoint
        the stylesheet uses. -#}
    <details id="pick-selection-help" class="picker-selection-help">
      <summary>Editing help</summary>
      <span id="pick-selection-hint" class="pick-status"></span>
      {#- #363. Saved to this person's settings on change, so hiding the
          tooltips once hides them for good. -#}
      <label class="pick-vertex-tooltips">
        <input type="checkbox" id="pick-vertex-tooltips"
               {% if show_vertex_tooltips %}checked{% endif %}>
        Show tooltips on vertices
      </label>
    </details>
  </div>
  {% endif %}

  <div id="pick-error" class="warning" role="status" aria-live="polite" hidden>
    <div id="pick-error-text"></div>
    <button type="button" id="pick-error-dismiss" class="error-overlay-dismiss" aria-label="Dismiss">&times;</button>
  </div>

  <dialog id="image-dialog">
    <h2>Download rendered image</h2>
    <p class="hint">
      The whole radargram as one image, in the profile currently selected.
    </p>
    <div class="add-layer-fields">
      <label>Width
        <select id="image-width"></select>
      </label>
      <label>Format
        <select id="image-format">
          <option value="png" selected>PNG (lossless)</option>
          <option value="jpeg">JPEG (smaller)</option>
        </select>
      </label>
      <label id="image-quality-field" hidden>Quality
        <select id="image-quality">
          <option value="95">95 (best)</option>
          <option value="85" selected>85</option>
          <option value="70">70 (smallest)</option>
        </select>
      </label>
    </div>
    <p class="hint" id="image-estimate"></p>
    <p>
      <button type="button" id="image-go">Download</button>
      <button type="button" id="image-close">Close</button>
    </p>
  </dialog>

  {#- Annotated figure export (#142). figure.js builds a figure spec from
      these controls and asks `POST .../figure` for a preview and the
      download, so what is previewed is what downloads. -#}
  {% if can_download_derived %}
  <dialog id="figure-dialog" class="figure-dialog">
    <h2>Figure</h2>
    <div class="figure-layout">
      <form class="figure-controls" id="figure-form">
        <fieldset>
          <legend>Extent</legend>
          <p class="figure-buttons">
            <button type="button" id="fig-extent-view">Current view</button>
            <button type="button" id="fig-extent-draw">Draw rectangle</button>
            <button type="button" id="fig-extent-all">Whole radargram</button>
          </p>
          <div class="figure-grid">
            <label><span id="fig-x-from-label">From</span>
              <input type="number" id="fig-x0" step="any"></label>
            <label><span id="fig-x-to-label">To</span>
              <input type="number" id="fig-x1" step="any"></label>
            <label><span id="fig-y-from-label">Top</span>
              <input type="number" id="fig-y0" step="any"></label>
            <label><span id="fig-y-to-label">Bottom</span>
              <input type="number" id="fig-y1" step="any"></label>
          </div>
          <p class="hint" id="fig-extent-note"></p>
        </fieldset>
        <fieldset>
          <legend>Size</legend>
          <div class="figure-grid">
            <label>Width <input type="number" id="fig-width" min="1" step="any" value="16"></label>
            <label>Unit
              <select id="fig-unit">
                <option value="cm" selected>cm</option>
                <option value="in">in</option>
                <option value="px">px</option>
              </select></label>
            <label>DPI <input type="number" id="fig-dpi" min="10" max="2400" step="1" value="300"></label>
            <label title="The viewer's horizontal scale: how many units wide each trace is for every row tall.">Horizontal scale
              <input type="number" id="fig-xscale" min="0" step="any" value="1"></label>
          </div>
          <p class="hint" id="fig-size-note"></p>
        </fieldset>
        <fieldset>
          <legend>Axes</legend>
          <div class="figure-grid">
            <label>x unit
              <select id="fig-x-unit">
                <option value="distance" selected>Distance (m)</option>
                <option value="distance_km">Distance (km)</option>
                <option value="trace">Trace</option>
                <option value="time">Time (UTC)</option>
              </select></label>
            <label>y unit
              <select id="fig-y-unit">
                <option value="twtt" selected>Two-way travel time (ns)</option>
                <option value="depth">Depth (m)</option>
                <option value="sample">Sample</option>
                <option value="elevation">Elevation (m)</option>
              </select></label>
            <label title="Blank picks a round spacing.">x spacing
              <input type="number" id="fig-x-spacing" min="0" step="any" placeholder="auto"></label>
            <label title="Blank picks a round spacing.">y spacing
              <input type="number" id="fig-y-spacing" min="0" step="any" placeholder="auto"></label>
            <label title="Ticks are at anchor + k × spacing.">x anchor
              <input type="number" id="fig-x-anchor" step="any" value="0"></label>
            <label title="Ticks are at anchor + k × spacing.">y anchor
              <input type="number" id="fig-y-anchor" step="any" value="0"></label>
            <label title="Blank uses the unit's own label.">x label
              <input type="text" id="fig-x-label" placeholder="default"></label>
            <label title="Blank uses the unit's own label.">y label
              <input type="text" id="fig-y-label" placeholder="default"></label>
            <label title="The x value labelled 0, in the x unit. Labels count from here.">x zero at
              <input type="number" id="fig-x-zero" step="any" value="0"></label>
          </div>
          <label class="figure-check" title="Labels are the zero point minus the value, so a profile surveyed from the terminus can be labelled from the glacier head."><input type="checkbox" id="fig-x-descending"> Count x labels down</label>
          <label class="figure-check" title="Mirror the radargram, the layers and the ticks, so the end of the extent is on the left."><input type="checkbox" id="fig-x-reverse"> Mirror left to right</label>
          <label class="figure-check"><input type="checkbox" id="fig-axes" checked> Axes and labels</label>
        </fieldset>
        <fieldset>
          <legend>Style</legend>
          <div class="figure-grid">
            <label>Font size (pt) <input type="number" id="fig-font" min="1" max="200" step="0.5" value="10"></label>
            <label>Text colour <input type="color" id="fig-color" value="#000000"></label>
            <label>Background <input type="color" id="fig-background" value="#ffffff"></label>
            <label class="figure-check"><input type="checkbox" id="fig-transparent"> Transparent</label>
            <label class="figure-check" title="An outline around the labels, ticks and frame, so they read on a light or a dark page. It never covers the radargram."><input type="checkbox" id="fig-halo"> Halo</label>
            <label>Halo colour <input type="color" id="fig-halo-color" value="#ffffff"></label>
            <label>Halo width (pt) <input type="number" id="fig-halo-width" min="0.1" max="20" step="0.1" value="1"></label>
          </div>
          <label class="figure-check"><input type="checkbox" id="fig-radargram" checked> Show radargram</label>
        </fieldset>
        <fieldset>
          <legend>Layers</legend>
          <label class="figure-check"><input type="checkbox" id="fig-layers"> Show layers</label>
          {#- Disabled as a whole while "Show layers" is off. -#}
          <fieldset class="figure-layer-controls" id="fig-layer-controls" disabled>
          <details class="figure-picker" id="fig-picks-picker">
            <summary>Picks: <span id="fig-picks-summary">none</span></summary>
            <div id="fig-picks-list" class="figure-picker-list"></div>
          </details>
          <div class="figure-grid">
            <label>Pick width (pt) <input type="number" id="fig-picks-width" min="0.1" max="20" step="0.1" value="1"></label>
            <label>Pick opacity <input type="number" id="fig-picks-opacity" min="0" max="1" step="0.05" value="0.85"></label>
          </div>
          <details class="figure-picker" id="fig-derived-picker">
            <summary>Derived: <span id="fig-derived-summary">none</span></summary>
            <div id="fig-derived-list" class="figure-picker-list"></div>
          </details>
          <div class="figure-grid">
            <label>Derived width (pt) <input type="number" id="fig-derived-width" min="0.1" max="20" step="0.1" value="1.5"></label>
            <label>Derived opacity <input type="number" id="fig-derived-opacity" min="0" max="1" step="0.05" value="0.9"></label>
          </div>
          <label class="figure-check"><input type="checkbox" id="fig-fills" checked> Range fills</label>
          </fieldset>
        </fieldset>
      </form>
      <div class="figure-preview-pane">
        <div class="figure-preview" id="fig-preview">
          <img id="fig-preview-image" alt="Figure preview" hidden>
          <p class="figure-preview-status" id="fig-preview-status">Choose an extent to preview the figure.</p>
        </div>
        <p class="figure-buttons">
          <button type="button" id="fig-update">Update preview</button>
        </p>
        <div id="fig-messages" class="figure-messages" role="status" aria-live="polite"></div>
      </div>
    </div>
    <p class="figure-buttons figure-actions">
      <button type="button" id="fig-download-spec" class="figure-minor" title="The figure spec as JSON: draw this figure again with ridal render --figure, ridal.render or the API.">Download spec</button>
      <span class="figure-actions-spacer"></span>
      <label>Format
        <select id="fig-format">
          <option value="png" selected>PNG</option>
          <option value="svg">SVG</option>
        </select></label>
      <button type="button" id="fig-download">Download</button>
      <button type="button" id="fig-close">Close</button>
    </p>
  </dialog>
  {% endif %}

  {#- The render profile editor (#183). The preview is one image of the
      extent on screen, drawn by the server with the unsaved profile; only
      saving makes the viewer render tiles with it. Limits from the server
      are data attributes, so profile_editor.js holds no copy of them. -#}
  {% if edit_personal or edit_project %}
  <dialog id="profile-dialog" class="figure-dialog"
          data-edit-personal="{% if edit_personal %}true{% else %}false{% endif %}"
          data-edit-project="{% if edit_project %}true{% else %}false{% endif %}"
          data-siglog-default="{{ siglog_default }}" data-offset-default="{{ offset_default }}"
          data-max-stops="{{ max_color_stops }}">
    <h2>Edit render profile</h2>
    <p class="hint" id="pe-origin"></p>
    <div class="figure-layout">
      <form class="figure-controls" id="pe-form" autocomplete="off">
        <fieldset>
          <legend>Start from</legend>
          <div class="figure-grid">
            <label>Profile <select id="pe-start"></select></label>
          </div>
        </fieldset>
        <fieldset>
          <legend>Colours</legend>
          <div class="figure-grid">
            <label>Colour scale <select id="pe-preset"></select></label>
          </div>
          <div id="pe-stops" class="profile-stops"></div>
          <p class="figure-buttons">
            <button type="button" id="pe-add-stop">Add stop</button>
            <button type="button" id="pe-reverse">Reverse</button>
          </p>
          <div class="figure-grid">
            <label class="figure-check"><input type="checkbox" id="pe-nodata-on"> No-data colour</label>
            <label>Colour <input type="color" id="pe-nodata" value="#808080"></label>
          </div>
        </fieldset>
        <fieldset>
          <legend>Amplitude</legend>
          <div class="figure-grid">
            <label title="Applied to every sample before anything else.">Source transform
              <select id="pe-source">
                <option value="None">None</option>
                <option value="SigLog">Signed log</option>
                <option value="AdaptiveSigLog">Adaptive signed log</option>
              </select></label>
            <label id="pe-siglog-row" title="log10 of the magnitude below which samples become zero.">Strength (log10)
              <input type="number" id="pe-siglog" step="0.1" min="-20" max="20"></label>
            <label id="pe-offset-row" title="The strength is log10(noise floor) + this offset.">Offset from noise (log10)
              <input type="number" id="pe-offset" step="0.1" min="-20" max="20"></label>
            <label>Transform
              <select id="pe-transform">
                <option value="Linear">Linear</option>
                <option value="AbsLog">Log of magnitude</option>
                <option value="Positive">Positive</option>
              </select></label>
            <label>Limits
              <select id="pe-limits">
                <option value="Percentile">Percentiles</option>
                <option value="Explicit">Explicit amplitudes</option>
              </select></label>
            <label class="pe-percentile">Low percentile (%)
              <input type="number" id="pe-low" step="0.5" min="0" max="100"></label>
            <label class="pe-percentile">High percentile (%)
              <input type="number" id="pe-high" step="0.5" min="0" max="100"></label>
            <label class="pe-explicit">Minimum
              <input type="number" id="pe-min" step="any"></label>
            <label class="pe-explicit">Maximum
              <input type="number" id="pe-max" step="any"></label>
            <label class="figure-check" title="Limits at plus and minus the larger of the two, so that zero is the middle of the scale."><input type="checkbox" id="pe-symmetric"> Symmetric about zero</label>
            <label class="pe-percentile" title="Rows at the top of every trace left out of the percentiles, to keep the direct wave out of them.">Skip first samples
              <input type="number" id="pe-skip" step="1" min="0"></label>
          </div>
        </fieldset>
        <fieldset>
          <legend>Appearance</legend>
          <div class="figure-grid">
            <label>Contrast <span><input type="range" id="pe-contrast" min="0.1" max="5" step="0.05">
              <output id="pe-contrast-value" for="pe-contrast"></output></span></label>
            <label>Black level <span><input type="range" id="pe-black" min="-0.9" max="0.9" step="0.01">
              <output id="pe-black-value" for="pe-black"></output></span></label>
          </div>
        </fieldset>
        <div id="pe-warnings" class="figure-messages" role="status" aria-live="polite"></div>
      </form>
      <div class="figure-preview-pane">
        <div class="figure-preview" id="pe-preview">
          <img id="pe-image" alt="Preview of the render profile" hidden>
          <p class="figure-preview-status" id="pe-status">Update the preview to see the profile.</p>
        </div>
        <p class="figure-buttons">
          <button type="button" id="pe-update">Update preview</button>
          <label class="figure-check"><input type="checkbox" id="pe-auto"> Auto update</label>
          <button type="button" id="pe-compare" aria-pressed="false" disabled
                  title="Show the preview before the last update, to compare.">Show previous</button>
          <button type="button" id="pe-extent" title="Preview what the viewer shows now.">Use current view</button>
        </p>
        <p class="hint" id="pe-extent-note"></p>
      </div>
    </div>
    <div class="figure-buttons figure-actions">
      <label>Name <input type="text" id="pe-name" size="16" spellcheck="false"></label>
      <label>Save to
        <select id="pe-scope">
          {% if edit_personal %}<option value="personal">My profiles</option>{% endif %}
          {% if edit_project %}<option value="project">Project</option>{% endif %}
        </select></label>
      <label id="pe-thumbnail-row" title="The catalog's thumbnails are drawn with a shared profile while this one is chosen.">Thumbnails
        <select id="pe-thumbnail"></select></label>
      <button type="button" id="pe-delete" class="figure-minor" hidden>Delete</button>
      <span class="figure-actions-spacer"></span>
      <span id="pe-save-status" class="pick-status"></span>
      <button type="button" id="pe-save">Save</button>
      {#- "Cancel" while there are edits it would throw away, "Close" once
          they are saved: profile_editor.js switches it. -#}
      <button type="button" id="pe-close">Cancel</button>
    </div>
  </dialog>
  {% endif %}

  <dialog id="download-dialog">
    <h2>Download layer points</h2>
    <p class="hint">
      Picked lines resampled to evenly spaced points along the ground track,
      with depth, travel time and position attached. Derived from the saved
      interpretation, so save first.
    </p>
    <p class="hint">
      WGS84 is the portable choice and what RFC 7946 requires of GeoJSON.
      Native CRS writes the radargram's own projected coordinates instead,
      which most GIS tools read but strict GeoJSON readers will take for
      degrees. Either way the projected easting and northing are also
      present as properties on every point.
    </p>
    {#- Both selects open on the resolved default (#166): this person's
        choice, then the project's, then Ridal's. Rendered from the server's
        own lists so the options, the settings page's and what `?spacing=`
        accepts cannot drift apart. -#}
    <div class="add-layer-fields">
      <label>Spacing
        <select id="download-spacing">
          {% for option in spacings %}
            <option value="{{ option.value }}"
              {%- if option.value == active_spacing %} selected{% endif %}>{{ option.label }}</option>
          {% endfor %}
        </select>
      </label>
      <label>Format
        <select id="download-format">
          {% for option in formats %}
            <option value="{{ option.value }}"
              {%- if option.value == active_format %} selected{% endif %}>{{ option.label }}</option>
          {% endfor %}
        </select>
      </label>
    </div>
    {% if can_administer %}
    {#- Admin only. One file with every contributor's points, each row still
        tagged with its user; the server enforces the role regardless. -#}
    <label class="checkbox">
      <input type="checkbox" id="download-every-user">
      For every user (all contributors' points in one file)
    </label>
    {% endif %}
    <p>
      <button type="button" id="download-go">Download</button>
      <button type="button" id="download-close">Close</button>
    </p>
  </dialog>

  <dialog id="derived-download-dialog">
    <h2>Download derived layer points</h2>
    <p class="hint">
      Derived layers &mdash; positions computed from the picks &mdash;
      resampled to evenly spaced points with depth, travel time and position
      attached. Unlisted layers are left out unless asked for.
    </p>
    <div class="add-layer-fields">
      <label>Spacing
        <select id="derived-download-spacing">
          {% for option in spacings %}
            <option value="{{ option.value }}"
              {%- if option.value == active_spacing %} selected{% endif %}>{{ option.label }}</option>
          {% endfor %}
        </select>
      </label>
      <label>Format
        <select id="derived-download-format">
          {% for option in formats %}
            <option value="{{ option.value }}"
              {%- if option.value == active_format %} selected{% endif %}>{{ option.label }}</option>
          {% endfor %}
        </select>
      </label>
    </div>
    <label class="checkbox">
      <input type="checkbox" id="derived-download-include-unlisted">
      Include unlisted
    </label>
    <p>
      <button type="button" id="derived-download-go">Download</button>
      <button type="button" id="derived-download-close">Close</button>
    </p>
  </dialog>

  {#- The radargram and the trace panel share one flex box (#181), so the
      trace can sit beside the radargram on a wide screen and drop below it
      when there is no room. The split resizer stays between this box and
      the overview map, so it still means "radargram area vs map" and the
      trace's presence does not disturb the wrap bookkeeping the #199 clamp
      relies on. -#}
  <div class="layout" id="viewer-layout">
    <div class="radar-region" id="radar-region">
      <div id="map"></div>
      <div id="trace-resizer" role="separator" aria-orientation="vertical"
           aria-label="Resize radargram and trace panels"
           aria-valuemin="0" aria-valuemax="100" aria-valuenow="60" tabindex="0" hidden></div>
      <div id="trace-view" hidden>
        <div class="trace-header">
          <span id="trace-label">trace: &ndash;</span>
          <span class="trace-zoom">
            <button type="button" id="trace-zoom-out"
                    title="Narrower trace (smaller amplitude)">&minus;</button>
            <button type="button" id="trace-zoom-in"
                    title="Wider trace (larger amplitude)">+</button>
          </span>
        </div>
        <canvas id="trace-canvas"></canvas>
        <p class="trace-hint" id="trace-hint">Click the radargram to choose a trace.</p>
      </div>
    </div>
    <div id="split-resizer" role="separator" aria-orientation="vertical"
         aria-label="Resize radargram and map panels"
         aria-valuemin="0" aria-valuemax="100" aria-valuenow="50" tabindex="0"></div>
    <div id="overview-map"></div>
  </div>

  {#- The derived-item editor is built by `RIDAL.derivedEditor` (app.js) so the
      /layers page uses the same dialog and save path. It is appended to the
      body on first open rather than templated here. -#}

  {% if project and can_operate %}
  {% include "radargram_dialogs.html.jinja" %}
  {% if radargram_in_project %}
  {% include "process_dialog.html.jinja" %}
  {% endif %}
  {% endif %}

  <dialog id="metadata-dialog">
    <h2>Metadata</h2>
    <table id="metadata-table"><tbody></tbody></table>
    <details class="meta-details" id="processing-details">
      <summary>Processing steps &amp; log</summary>
      <ol id="processing-steps-list"></ol>
      <pre id="processing-log"></pre>
    </details>
    <details class="meta-details" id="filepaths-details">
      <summary>Original filepaths</summary>
      <ul id="filepaths-list"></ul>
    </details>
    <p><button type="button" id="metadata-close">Close</button></p>
  </dialog>
{% endblock %}
{% block extrascript %}
{#- The only inline JS left on this page: server-side values the static
    viewer.js cannot know. Everything else lives in that file, so it stays
    a plain asset with no templating in it. -#}
<script>
  window.RIDAL_VIEWER = {
    radargramId: "{{ radargram_id }}",
    groupId: {% if group_id %}"{{ group_id }}"{% else %}null{% endif %},
    chunkSize: {{ chunk_size }},
    nCols: {{ n_cols }},
    nRows: {{ n_rows }},
    revisionId: "{{ revision_id }}",
    {#- The gprinterp anchor axes for this revision, or null when the
        radargram cannot describe them. Already JSON, built server-side,
        so it is emitted raw rather than re-escaped. -#}
    axes: {{ axes_json | safe }},
    viewerWidth: {{ viewer_width }},
    viewerHeight: {{ viewer_height }},
    sourceWidth: {{ shape_width }},
    sourceHeight: {{ shape_height }},
    maxImageWidth: {{ max_image_width }},
    maxImagePixels: {{ max_image_pixels }},
    writable: {% if writable %}true{% else %}false{% endif %},
    user: "{{ user }}",
    {#- Whether the picks are drawn when this page opens (#143), resolved
        from this person's settings. -#}
    showPicks: {% if show_picks %}true{% else %}false{% endif %},
    {#- Whether the viewer opens on the whole radargram rather than on its
        start (#315), from this person's settings. -#}
    openZoomedOut: {% if open_zoomed_out %}true{% else %}false{% endif %},
    {#- Whether the handles of a line being edited carry their tooltips
        (#363), from this person's settings. -#}
    showVertexTooltips: {% if show_vertex_tooltips %}true{% else %}false{% endif %},
  };
</script>
<script src="/static/viewer.js"></script>
<script src="/static/picker.js"></script>
<script src="/static/panel.js"></script>
<script src="/static/process.js"></script>
<script src="/static/radargram_edit.js"></script>
<script src="/static/figure.js"></script>
<script src="/static/profile_editor.js"></script>
{% endblock %}
