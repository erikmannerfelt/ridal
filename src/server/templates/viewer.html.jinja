{% extends "base.html.jinja" %}
{% block title %}{{ effective_label }} - Ridal{% endblock %}
{% block extrahead %}
<style>
  #map { width: 100%; height: 70vh; background: #222; }
  table.meta { border-collapse: collapse; margin-bottom: 0.75rem; }
  table.meta th, table.meta td { text-align: left; padding: 2px 10px 2px 0; }
</style>
{% endblock %}
{% block content %}
  <p><a href="/#card-{{ radargram_id }}">&larr; Back to catalog</a></p>
  <h1>{{ effective_label }}</h1>
  <table class="meta">
    <tr><th>Radargram ID</th><td><code>{{ radargram_id }}</code></td></tr>
    <tr><th>Group</th><td>{{ group or "(none)" }}</td></tr>
    <tr><th>Revision</th><td><code>{{ revision_id }}</code></td></tr>
    <tr><th>Processed</th><td>{{ processing_datetime }}</td></tr>
    <tr><th>Shape (samples x traces)</th><td>{{ shape_height }} &times; {{ shape_width }}</td></tr>
    <tr><th>Render profile</th>
      <td>
        <select id="profile-select">
          {% for p in profiles %}
          <option value="{{ p }}" {% if p == active_profile %}selected{% endif %}>{{ p }}</option>
          {% endfor %}
        </select>
      </td>
    </tr>
  </table>
  <div id="map"></div>
{% endblock %}
{% block extrascript %}
<script>
  {# radargram_id is a validated slug (identity.rs: [a-z0-9_-]+ only), so
     direct interpolation is safe -- it cannot contain quotes or
     backslashes. Avoids the `tojson` filter, which needs minijinja's
     "json" feature (not enabled). #}
  const RADARGRAM_ID = "{{ radargram_id }}";
  const VIEW = "standard";
  const CHUNK_SIZE = {{ chunk_size }};
  const N_COLS = {{ n_cols }};
  const N_ROWS = {{ n_rows }};
  const VIEWER_WIDTH = {{ viewer_width }};
  const VIEWER_HEIGHT = {{ viewer_height }};

  function currentProfile() {
    return document.getElementById('profile-select').value;
  }

  function chunkUrl(x, y, profile) {
    return `/api/v1/datasets/${RADARGRAM_ID}/views/${VIEW}/chunks/${profile}/${x}/${y}`;
  }

  function loadChunks(map, profile) {
    // Bounds formula verified in M0 against a real headless-Chromium
    // screenshot: places chunk (0,0) upper-left with no transposition.
    for (let y = 0; y < N_ROWS; y++) {
      for (let x = 0; x < N_COLS; x++) {
        const bounds = [
          [-(y * CHUNK_SIZE + CHUNK_SIZE), x * CHUNK_SIZE],
          [-(y * CHUNK_SIZE), x * CHUNK_SIZE + CHUNK_SIZE],
        ];
        L.imageOverlay(chunkUrl(x, y, profile), bounds).addTo(map);
      }
    }
  }

  const map = L.map('map', { crs: L.CRS.Simple, minZoom: -6, attributionControl: false });
  const overallBounds = [[-VIEWER_HEIGHT, 0], [0, VIEWER_WIDTH]];
  map.fitBounds(overallBounds);
  loadChunks(map, currentProfile());

  document.getElementById('profile-select').addEventListener('change', () => {
    const profile = currentProfile();
    const url = new URL(window.location.href);
    url.searchParams.set('profile', profile);
    window.history.replaceState({}, '', url);
    map.eachLayer((layer) => { if (layer instanceof L.ImageOverlay) map.removeLayer(layer); });
    loadChunks(map, profile);
  });
</script>
{% endblock %}
